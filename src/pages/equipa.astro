---
import Base from '../layouts/Base.astro';
import Team from '../components/Team.astro';
import ContactForm from '../components/ContactForm.astro';
import Watermark from '../components/Watermark.astro';
import TitleSplit from '../components/TitleSplit.astro';
import equipa from '../data/equipa.json';
import { urlAbsoluto } from '../utils/seo.js';
import { listaDePessoas } from '../utils/schema.js';

/* Pessoas com nome e função dão o sinal de E-E-A-T que o Google procura num
   negócio de construção: por trás da marca há profissionais identificáveis. */
const schemaEquipa = [
  listaDePessoas([...equipa.direcao.members, ...equipa.equipa.members], {
    url: urlAbsoluto('/equipa'),
    nome: 'Equipa AM Santos',
  }),
];
---
<Base tipoPagina="AboutPage" schemaExtra={schemaEquipa}>
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:100vh">
    <div
      class={equipa.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={equipa.hero.imagem ? `background-image:url(${equipa.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <TitleSplit text={equipa.hero.title} tag="h1" class="hero__title-page title-split--hero" data-i18n="equipa.hero.title" data-i18n-split="1" />
      </div>
    </div>
  </section>

  <!-- DIREÇÃO -->
  <section class="section">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="lg" y="top" />
      <TitleSplit text={equipa.direcao.title} data-i18n="equipa.direcao.title" data-i18n-split="1" />
      <Team members={equipa.direcao.members} variant="lead" i18nBase="equipa.direcao.members" />
    </div>
  </section>

  <!-- EQUIPA GERAL -->
  <section class="section section--alt">
    <div class="container has-wm">
      <Watermark variant="fill" side="l" size="lg" y="bottom" />
      <TitleSplit text={equipa.equipa.title} data-i18n="equipa.equipa.title" data-i18n-split="1" />
      <Team members={equipa.equipa.members} i18nBase="equipa.equipa.members" />
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <ContactForm title={equipa.contacto.title} texto={equipa.contacto.texto} titleI18n="equipa.contacto.title" textoI18n="equipa.contacto.texto" />
    </div>
  </section>
</Base>
