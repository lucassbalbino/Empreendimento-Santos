---
import Base from '../layouts/Base.astro';
import Team from '../components/Team.astro';
import ContactForm from '../components/ContactForm.astro';
import Stitch from '../components/Stitch.astro';
import Watermark from '../components/Watermark.astro';
import TitleSplit from '../components/TitleSplit.astro';
import equipa from '../data/equipa.json';
---
<Base title="Mockup — Equipa" description="A equipa da AM Santos — profissionais de arquitetura, engenharia, decoração e gestão imobiliária de alto nível.">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:100vh">
    <div
      class={equipa.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={equipa.hero.imagem ? `background-image:url(${equipa.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <TitleSplit text={equipa.hero.title} tag="h1" class="hero__title-page title-split--hero" />
      </div>
    </div>
  </section>

  <!-- DIREÇÃO -->
  <section class="section">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="lg" y="top" />
      <TitleSplit text={equipa.direcao.title} />
      <Team members={equipa.direcao.members} variant="lead" />
    </div>
  </section>

  <!-- COSTURA · Direção (branco) → Equipa geral (cinza) -->
  <Stitch variant="light" />

  <!-- EQUIPA GERAL -->
  <section class="section section--alt">
    <div class="container has-wm">
      <Watermark variant="fill" side="l" size="lg" y="bottom" />
      <TitleSplit text={equipa.equipa.title} />
      <Team members={equipa.equipa.members} />
    </div>
  </section>

  <!-- COSTURA · Equipa geral (cinza) → Contacto (branco) -->
  <Stitch variant="alt" />

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <ContactForm title={equipa.contacto.title} texto={equipa.contacto.texto} />
    </div>
  </section>
</Base>
