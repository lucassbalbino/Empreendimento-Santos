---
import Base from '../layouts/Base.astro';
import Team from '../components/Team.astro';
import ContactForm from '../components/ContactForm.astro';
import Stitch from '../components/Stitch.astro';
import equipa from '../data/equipa.json';
---
<Base title="Mockup — Equipa" description="A equipa da AM Santos — profissionais de arquitetura, engenharia, decoração e gestão imobiliária de alto nível, e as empresas do grupo (SF Properties e Valflores).">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:80vh">
    <div
      class={equipa.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={equipa.hero.imagem ? `background-image:url(${equipa.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <span class="eyebrow" style="color:#d29a5a">{equipa.hero.eyebrow}</span>
        <h1 class="display hero__title-page">{equipa.hero.title}</h1>
      </div>
    </div>
  </section>

  <!-- DIREÇÃO -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">{equipa.direcao.eyebrow}</span>
      <h2 class="display display--sm">{equipa.direcao.title}</h2>
      <Team members={equipa.direcao.members} variant="lead" />
    </div>
  </section>

  <!-- COSTURA · Direção (branco) → Equipa geral (cinza) -->
  <Stitch variant="light" />

  <!-- EQUIPA GERAL -->
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">{equipa.equipa.eyebrow}</span>
      <h2 class="display display--sm">{equipa.equipa.title}</h2>
      <Team members={equipa.equipa.members} />
    </div>
  </section>

  <!-- EMPRESAS DO GRUPO. Costura na fronteira de cor antes do 1.º bloco
       (cinza → branco). Entre as empresas (branco → branco) não há corte:
       não há cor a coser. -->
  {equipa.grupo.map((g, i) => (
    <>
      {i === 0 && <Stitch variant="alt" />}
      <section class="section">
        <div class="container">
          <h2 class="display display--sm" style="margin-bottom:clamp(28px,4vw,56px)">{g.title}</h2>
          <Team members={g.members} />
        </div>
      </section>
    </>
  ))}

  <!-- COSTURA · Empresas do grupo (branco) → Contacto (cinza) -->
  <Stitch variant="light" />

  <!-- CONTACTO -->
  <section class="section section--alt" id="contacto">
    <div class="container">
      <ContactForm eyebrow={equipa.contacto.eyebrow} title={equipa.contacto.title} texto={equipa.contacto.texto} />
    </div>
  </section>
</Base>
