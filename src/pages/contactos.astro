---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Watermark from '../components/Watermark.astro';
import TitleSplit from '../components/TitleSplit.astro';
import contactos from '../data/contactos.json';
const moradaLinhas = contactos.onde.morada.split('\n');
---
<Base tipoPagina="ContactPage">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:100vh">
    <div
      class={contactos.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={contactos.hero.imagem ? `background-image:url(${contactos.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <TitleSplit text={contactos.hero.title} tag="h1" class="hero__title-page title-split--hero" data-i18n="contactos.hero.title" data-i18n-split="1" />
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <ContactForm title={contactos.contacto.title} texto={contactos.contacto.texto} titleI18n="contactos.contacto.title" textoI18n="contactos.contacto.texto" />
      <p class="muted" style="margin-top:2rem">
        <a href={`mailto:${contactos.contacto.email}`}>{contactos.contacto.email}</a>
        &nbsp;·&nbsp;
        <a href={`tel:${contactos.contacto.telefone.replace(/\s+/g, '')}`}>{contactos.contacto.telefone}</a>
      </p>
    </div>
  </section>

  <!-- ONDE ESTAMOS -->
  <section class="section section--alt">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="md" y="top" />
      <div class="split">
        <div class="split__body">
          <TitleSplit text={contactos.onde.title} data-i18n="contactos.onde.title" data-i18n-split="1" />
          <p class="lead" style="margin-top:1rem" data-i18n="contactos.onde.morada" data-i18n-multiline>{moradaLinhas.map((linha, i) => (<>{i > 0 && <br />}{linha}</>))}</p>
        </div>
        <div class="split__media"><div class="ph" data-label={contactos.onde.mapaLabel}></div></div>
      </div>
    </div>
  </section>
</Base>
