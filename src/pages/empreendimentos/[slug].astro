---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Watermark from '../../components/Watermark.astro';
import data from '../../data/empreendimentos.json';

export function getStaticPaths() {
  return data.lista.map((proj) => ({
    params: { slug: proj.slug },
    props: { proj, todos: data.lista },
  }));
}

const { proj, todos } = Astro.props;

// O grupo define onde o projeto é listado (um projeto vendido vai para o
// histórico ainda que a obra decorra), por isso os textos abaixo derivam de
// proj.estado — a obra em si — e nunca do grupo.
const grupoLabel = proj.estado;

const concluido = proj.estado === 'Concluído';
const brandParagraph = concluido
  ? `Entregue pela AM Santos, o ${proj.nome} reflete a excelência que procuramos em cada projeto executado: uma arquitetura moderna e funcional, com um foco inabalável no bem-estar e na qualidade.`
  : `Como em todos os empreendimentos AM Santos, o ${proj.nome} nasce de uma visão centrada no conforto, na qualidade e na sustentabilidade — com a eficiência energética a guiar cada decisão de projeto.`;
const ctaLabel = concluido ? 'Falar connosco' : (proj.estado === 'Em construção' ? 'Agendar visita' : 'Saber mais');

const relacionados = todos.filter((p) => p.grupo === proj.grupo && p.slug !== proj.slug).slice(0, 3);

// Galeria: imagem principal + galeria própria. Só o Valflores Terraces e o CLT
// têm fotos reais; nos restantes a imagem é provisória (ver imagemReal).
const galeria = [proj.imagem, ...(proj.galeria ?? [])].filter(Boolean);
---
<Base
  title={`Empreendimento — ${proj.nome}`}
  description={`${proj.nome} — ${proj.localizacao} · ${proj.tipologia}. ${proj.resumo}`}
>
  <!-- HERO -->
  <section class="hero emp-hero" style="min-height:80vh">
    <div
      class={proj.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={proj.imagem ? `background-image:url(${proj.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    {proj.imagem && !proj.imagemReal && <span class="img-prov img-prov--hero">Imagem provisória</span>}
    <div class="hero__inner">
      <div class="container">
        <a class="emp-back" href="/portfolio">← Empreendimentos</a>
        <span class="eyebrow" style="color:#d29a5a">{grupoLabel}</span>
        <h1 class="display hero__title-page">{proj.nome}</h1>
        <p class="emp-hero__meta">
          {proj.localizacao} · {proj.tipologia}
          <span class="emp-chip">{proj.estado}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- O EMPREENDIMENTO -->
  <section class="section">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="md" y="top" />
      <div class="split">
        <div class="split__body">
          <span class="eyebrow">O empreendimento</span>
          <h2 class="display display--sm">{proj.entrega}</h2>
          <p>{proj.resumo}</p>
          <p>{brandParagraph}</p>
          <a class="btn" href="#contacto">{ctaLabel}</a>
        </div>
        <div class="split__media">
          {proj.galeria?.[0]
            ? <img class="split__img" src={proj.galeria[0]} alt={proj.nome} loading="lazy" />
            : <div class="ph" data-label="Imagem 4:5"></div>}
        </div>
      </div>
    </div>
  </section>

  <!-- CARACTERÍSTICAS -->
  <section class="section section--alt">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="sm" y="bottom" />
      <span class="eyebrow">Características</span>
      <h2 class="display display--sm">Ficha do empreendimento</h2>
      <div class="facts">
        {proj.factos.map((f) => (
          <div class="fact">
            <span class="fact__v">{f.valor}</span>
            <span class="fact__r">{f.rotulo}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {proj.galeria?.length > 0 && (
    <!-- GALERIA (só quando há mesmo imagens deste empreendimento) -->
    <section class="section">
      <div class="container has-wm">
        <Watermark variant="line" side="r" size="md" y="top" />
        <span class="eyebrow">Galeria</span>
        <h2 class="display display--sm">Imagens do empreendimento</h2>
        <div class="gallery">
          {galeria.map((src, i) => (
            <img class="gallery__img" src={src} alt={`${proj.nome} — imagem ${i + 1}`} loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- LOCALIZAÇÃO -->
  <section class="section section--alt">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="md" y="top" />
      <div class="split">
        <div class="split__body">
          <span class="eyebrow">Localização</span>
          <h2 class="display display--sm">{proj.localizacao}</h2>
          <p class="lead" style="margin-top:1rem">{proj.concelho}</p>
        </div>
        <div class="split__media"><div class="ph" data-label="Mapa"></div></div>
      </div>
    </div>
  </section>

  {relacionados.length > 0 && (
    <!-- OUTROS EMPREENDIMENTOS -->
    <section class="section">
      <div class="container has-wm">
        <Watermark variant="line" side="l" size="md" y="bottom" />
        <span class="eyebrow">Outros empreendimentos</span>
        <h2 class="display display--sm">Continue a explorar</h2>
        <div class="grid-projects">
          {relacionados.map((p) => (<ProjectCard proj={p} />))}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="sm" y="bottom" />
      <ContactForm
        eyebrow="Contactos"
        title={`Interessado no ${proj.nome}?`}
        texto="Fale connosco para agendar uma visita ou pedir mais informações sobre este empreendimento. A nossa equipa responde com brevidade."
      />
    </div>
  </section>
</Base>
