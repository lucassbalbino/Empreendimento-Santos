---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Watermark from '../../components/Watermark.astro';
import PlansSlider from '../../components/PlansSlider.astro';
import Blob from '../../components/Blob.astro';
import TitleSplit from '../../components/TitleSplit.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import textos from '../../data/empreendimento.json';
import { todos, FASES } from '../../utils/projetos.js';
import { urlAbsoluto } from '../../utils/seo.js';
import { imovel } from '../../utils/schema.js';
import {
  tituloEmpreendimento,
  descricaoEmpreendimento,
} from '../../utils/empreendimento-seo.js';

export function getStaticPaths() {
  return todos.map((proj) => ({ params: { slug: proj.slug }, props: { proj } }));
}

const { proj } = Astro.props;
const comNome = (texto) => texto.split('{nome}').join(proj.nome);

// Botão e parágrafo seguem o estado da obra (não a fase): um projeto vendido
// ainda em construção continua a convidar para uma visita.
const concluido = proj.estado === 'Concluído';
const brandParagraph = comNome(concluido ? textos.paragrafo.concluido : textos.paragrafo.outro);
const brandParagraphI18n = concluido ? 'common.projectDetail.brandConcluido' : 'common.projectDetail.brandOutro';
const botao = {
  'Em projeto': { texto: textos.botao.emProjeto, i18n: 'ctaSaber' },
  'Em construção': { texto: textos.botao.emConstrucao, i18n: 'ctaVisita' },
  'Concluído': { texto: textos.botao.concluido, i18n: 'ctaFalar' },
}[proj.estado];
const i18nBase = `empreendimentos.${proj.slug}`;

const relacionados = todos.filter((p) => p.grupo === proj.grupo && p.slug !== proj.slug).slice(0, 3);

// Galeria: imagem principal + galeria própria. Só o Valflores Terraces e o CLT
// têm fotos reais; nos restantes a imagem é provisória (ver imagemReal).
const galeria = [proj.imagem, ...(proj.galeria ?? [])].filter(Boolean);

/* ------------------------------- SEO da ficha -------------------------------
   O caminho de volta depende do grupo: um empreendimento concluído vive no
   /historico, os outros no /portfolio. É essa a hierarquia que o utilizador
   percorreu e é essa que as migalhas — visíveis e no BreadcrumbList — declaram.

   A página é tipada como RealEstateListing (subtipo de WebPage): é o tipo que
   o schema.org define para "uma página que descreve uma oferta imobiliária",
   e é o que liga a ficha à entidade do imóvel, marcada em separado. */
/* O pai vem do `grupo` e não do `estado`: é o `grupo` que decide em que
   listagem o empreendimento aparece (ver porGrupo em utils/projetos.js), e uma
   migalha tem de devolver o visitante à página de onde ele veio. Três projetos
   do grupo "concluido" têm estado "Em projeto"/"Em construção" — por `estado`,
   a migalha mandava-os para o /portfolio, onde não estão listados. */
const migalhas = [
  { nome: 'Início', caminho: '/' },
  FASES[proj.grupo].listagem,
  { nome: proj.nome, caminho: `/empreendimentos/${proj.slug}` },
];

const urlFicha = urlAbsoluto(`/empreendimentos/${proj.slug}`);
const seoTitulo = tituloEmpreendimento(proj);
const seoDescricao = descricaoEmpreendimento(proj);
---
<Base
  title={seoTitulo}
  description={seoDescricao}
  image={proj.imagem}
  tipoPagina="RealEstateListing"
  trilhoItens={migalhas}
  schemaExtra={[imovel(proj, urlFicha)]}
  preloadImagem={proj.imagem}
>
  <!-- HERO — o mesmo desenho da home: foto a ecrã inteiro, só o nome e a
       indicação de scroll. A morada, a tipologia e o estado saíram daqui; são
       dados de ficha e já vivem na "Ficha do empreendimento" mais abaixo. -->
  <Hero title={proj.nome} image={proj.imagem} titleI18n={`${i18nBase}.nome`}>
    {proj.imagem && !proj.imagemReal && <span class="img-prov img-prov--hero" data-i18n="common.projectDetail.provisoria">Imagem provisória</span>}
  </Hero>

  <!-- O EMPREENDIMENTO — mesma estrutura do "Quem Somos" da home: título
       centrado com a marca-d'água atrás, bloco editorial numa grelha de 12
       colunas e CTA encostado à direita. Era um .split (texto à esquerda,
       imagem à direita); a imagem saiu — as fotos do empreendimento têm agora
       secção própria, o slider, e aqui repetiam-se.
       Diferença face ao Quem Somos: lá o editorial é meta + UM parágrafo lado
       a lado; aqui são os dois parágrafos em escada, desencontrados na grelha
       (ver .emp-editorial em styles.css). -->
  <section class="section section--tight-bottom emp-sobre">
    <div class="container">
      <Breadcrumbs itens={migalhas} />
      <div class="emp-intro has-wm">
        <Watermark variant="line" side="r" size="lg" y="top" />
        <TitleSplit text={proj.entrega} class="title-split--center" data-i18n={`${i18nBase}.entrega`} data-i18n-split="1" />
      </div>

      <div class="emp-editorial">
        <p class="emp-editorial__p emp-editorial__p--lead" data-i18n={`${i18nBase}.resumo`}>{proj.resumo}</p>
        <p class="emp-editorial__p emp-editorial__p--tail" data-i18n-tpl={brandParagraphI18n}>{brandParagraph}</p>
      </div>

      <div class="emp-cta">
        <a class="btn" href="#contacto" data-i18n={`common.projectDetail.${botao.i18n}`}>{botao.texto}</a>
      </div>
    </div>
  </section>

  <!-- CARACTERÍSTICAS — faixa café.
       Mesmo padrão de cor do bloco "Projetos futuros" do /portfolio: a mesma
       .section--dark (o --dark é #241a12, castanho escuro, não preto), o mesmo
       <Blob> a dar textura aos cantos e as mesmas chapas invertidas nos cartões
       (ver `.section--dark .fact` em styles.css). Era areia (.section--alt);
       passa a ser o único bloco escuro da página de detalhe.
       Sem marca-d'água: ela e o <Blob> dividiam o mesmo canto direito e as duas
       texturas claras sobre o café liam-se como ruído, não como fundo. Aqui
       quem dá textura é o Blob. -->
  <section class="section section--dark has-blob" style="padding-top:calc(var(--section-y) - clamp(24px,3vw,40px));padding-bottom:calc(var(--section-y-tight) + clamp(24px,3vw,40px))">
    <Blob />
    <div class="container">
      <TitleSplit text={textos.fichaTitulo} data-i18n="common.projectDetail.ficha" data-i18n-split="1" />
      <div class="facts">
        {proj.factos.map((f, i) => (
          <div class="fact">
            <span class="fact__v" data-i18n={`${i18nBase}.factos.${i}`}>{f.valor}</span>
            <span class="fact__r" data-i18n-label={f.rotulo}>{f.rotulo}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {proj.galeria?.length > 0 && (
    <!-- GALERIA (só quando há mesmo imagens deste empreendimento) -->
    <section class="section section--tight-bottom">
      <!-- Sem marca-d'água, ao contrário das outras secções desta página: a
           marca vive no canto superior direito e é exactamente aí que passou a
           estar a coluna de miniaturas do slider. Fica por trás (z-index:-1 no
           .wm-layer), mas espreitava pelos intervalos entre miniaturas e passava
           por baixo do contador — que deixava de se ler. A marca existe para
           habitar espaço vazio e esta secção deixou de ter nenhum. -->
      <div class="container">
        <TitleSplit text={textos.imagensTitulo} data-i18n="common.projectDetail.imagens" data-i18n-split="1" />
        <PlansSlider imagens={galeria} nome={proj.nome} />
      </div>
    </section>
  )}

  <!-- LOCALIZAÇÃO -->
  <section class="section section--tight-bottom">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="md" y="top" />
      <div class="split">
        <div class="split__body">
          <TitleSplit text={proj.localizacao} />
          <p class="lead" style="margin-top:1rem">{proj.concelho}</p>
        </div>
        <div class="split__media"><div class="ph" data-label={textos.mapaLegenda} data-i18n="common.projectDetail.mapa" data-i18n-attr="data-label"></div></div>
      </div>
    </div>
  </section>

  {relacionados.length > 0 && (
    <!-- OUTROS EMPREENDIMENTOS -->
    <section class="section section--tight-bottom">
      <div class="container has-wm">
        <Watermark variant="line" side="l" size="md" y="bottom" />
        <TitleSplit text={textos.continuarTitulo} data-i18n="common.projectDetail.continuar" data-i18n-split="1" />
        <div class="grid-projects">
          {relacionados.map((p) => (<ProjectCard proj={p} />))}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="sm" y="bottom" />
      <ContactForm
        title={comNome(textos.contacto.title)}
        texto={comNome(textos.contacto.texto)}
        titleI18nTpl="common.projectDetail.interessadoTitle"
        textoI18n="common.projectDetail.interessadoTexto"
      />
    </div>
  </section>

  <!-- Dados mínimos para os scripts de i18n (main.js): permite ao template
       data-i18n-tpl substituir {nome} pelo nome traduzido deste empreendimento. -->
  <script type="application/json" id="i18n-page-data" set:html={JSON.stringify({ slug: proj.slug, nome: proj.nome })}></script>
</Base>
