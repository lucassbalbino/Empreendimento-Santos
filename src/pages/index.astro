---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import DoubleSlider from '../components/DoubleSlider.astro';
import ExpandPanels from '../components/ExpandPanels.astro';
import BlockHead from '../components/BlockHead.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import Watermark from '../components/Watermark.astro';
import home from '../data/home.json';
import { porGrupo, emDestaque } from '../utils/projetos.js';

// Mantém o <em> do meio do título "O Que Fazemos" como no mockup original.
const fazemosTitle = home.oQueFazemos.title.replace(/—\s*(\S+)\s*—/, '— <em>$1</em> —');

// Destaques derivados da fonte única — em construção e em projeto no slider,
// concluídos no histórico.
const destaques = emDestaque(8);
const concluidos = porGrupo('concluido').slice(0, 5);

// Equipa como carrossel: cada card é um membro (foto | nome | cargo | bio).
const equipaCards = home.equipa.members.map((m) => ({
  quote: m.bio,
  name: m.name,
  designation: m.role,
  src: m.foto || '',
}));
---
<Base title="Mockup — Início" description="AM Santos — construindo o futuro com qualidade e sustentabilidade. 20 anos de experiência, com uma equipa de arquitetura, engenharia, decoração e gestão imobiliária.">
  <Hero title={home.hero.title} image={home.hero.imagem} />

  <!-- Camada que sobe e cobre a hero fixa (sticky reveal). Fundo opaco para a
       imagem estática só se ver na hero, nunca por trás das secções. -->
  <div class="home-reveal">

  <!-- GRUPO 1 · IDENTIDADE — "Quem Somos" e "O Que Fazemos" são o mesmo
       capítulo, por isso encostam-se (espaçamento curto entre ambos). -->

  <!-- QUEM SOMOS -->
  <section class="section section--tight-bottom quemsomos">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" />
      <div class="quemsomos__intro">
        <span class="eyebrow">{home.quemSomos.eyebrow}</span>
        <h2 class="display">{home.quemSomos.title}</h2>
        <a class="btn" href="/sobre-nos">{home.quemSomos.botao}</a>
      </div>
    </div>
    <div class="quemsomos__media reveal-rise-slow">
      {home.quemSomos.imagem
        ? <img class="quemsomos__img" src={home.quemSomos.imagem} alt="Fachada de empreendimento AM Santos" loading="lazy" />
        : <div class="ph" data-label="Imagem 16:9"></div>}
    </div>
  </section>

  <!-- CONTADORES — faixa de números entre as duas secções do capítulo da
       identidade. Fora de <section> para escapar à cortina de revelação. -->
  <div class="seam">
    <div class="container">
      <Stats items={home.oQueFazemos.stats} />
    </div>
  </div>

  <!-- O QUE FAZEMOS — sobre o mesmo branco do "Quem Somos": os dois são o
       mesmo capítulo. O laranja vive nos números e nas eyebrows, em toda a
       página, em vez de saturar uma só secção. -->
  <section class="section section--fazemos">
    <div class="container dofazemos">
      <h2 class="display" set:html={fazemosTitle}></h2>
    </div>
  </section>

  <!-- COSTURA · fronteira de cor branco → escuro. Triângulo branco (cor da
       secção anterior) desce sobre o topo do Portfolio e um fio laranja cose o
       corte na diagonal, desenhado ao revelar. Fica fora de <section> para
       escapar à cortina de revelação. -->
  <div class="stitch stitch--light">
    <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <polygon class="stitch__wedge" points="0,0 1000,0 0,60"></polygon>
      <line class="stitch__thread" x1="0" y1="60" x2="1000" y2="0" pathLength="1"></line>
    </svg>
  </div>

  <!-- GRUPO 2 · OBRA — portfolio e histórico partilham o bloco escuro e
       encostam-se, para se lerem como um único capítulo. -->

  <!-- PORTFOLIO -->
  <section class="section section--dark section--flush">
    <DoubleSlider
      projetos={destaques}
      eyebrow={home.portfolio.eyebrow}
      titulo={home.portfolio.title}
      botao={home.portfolio.botao}
      href="/portfolio"
    />
  </section>

  <!-- COSTURA · fronteira de cor escuro → branco (Portfolio → Histórico).
       Triângulo escuro (cor do Portfolio) desce sobre o topo branco do
       Histórico e o fio laranja cose o corte na diagonal. Fora de <section>
       para escapar à cortina de revelação. -->
  <div class="stitch stitch--dark">
    <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <polygon class="stitch__wedge" points="0,0 1000,0 0,60"></polygon>
      <line class="stitch__thread" x1="0" y1="60" x2="1000" y2="0" pathLength="1"></line>
    </svg>
  </div>

  <!-- TRACK RECORD (Histórico) — secção branca autónoma: sai do bloco escuro
       da Obra, com mais respiro no topo. Ver .section--panels-cut. -->
  <section class="section section--panels-cut">
    <div class="container">
      <BlockHead eyebrow={home.trackRecord.eyebrow} title={home.trackRecord.title} lead={home.trackRecord.lead} botao={home.trackRecord.botao} href="/portfolio" />
    </div>
    <!-- Fora do .container de propósito: os painéis sangram de bordo a bordo e
         descem para dentro da costura diagonal (ver .section--panels-cut). -->
    <ExpandPanels projetos={concluidos} />
  </section>

  <!-- COSTURA · fronteira de cor branco → cinza (Histórico → Equipa).
       Triângulo branco (cor do Histórico) desce sobre o topo do bloco seguinte
       e o fio laranja cose o corte na diagonal.
       Duas camadas: os painéis (z7) descem RENTES a esta diagonal, entre a
       cunha (z6) e o fio (z8). Ver .section--panels-cut. -->
  <div class="stitch stitch--light">
    <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <polygon class="stitch__wedge" points="0,0 1000,0 0,60"></polygon>
    </svg>
  </div>
  <div class="stitch stitch--light stitch--thread-top">
    <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <line class="stitch__thread" x1="0" y1="60" x2="1000" y2="0" pathLength="1"></line>
    </svg>
  </div>

  <!-- GRUPO 3 · PESSOAS — equipa e contacto encostam-se: conhecer quem
       faz e falar com quem faz são o mesmo movimento. -->

  <!-- EQUIPA (carrossel: cada card é um membro) -->
  <section class="section section--alt section--tight-bottom">
    <div class="container">
      <span class="eyebrow">{home.equipa.eyebrow}</span>
      <h2 class="display display--sm" style="margin-bottom:clamp(32px,4vw,56px)">{home.equipa.title}</h2>
      <Testimonials
        testimonials={equipaCards}
        autoplay={true}
        colors={{
          name: 'var(--ink)',
          designation: 'var(--ink-faint)',
          testimony: 'var(--ink-soft)',
          arrowBackground: 'var(--dark)',
          arrowForeground: 'var(--paper)',
          arrowHoverBackground: 'var(--accent)',
        }}
        fontSizes={{ name: '1.9rem', designation: '0.8rem', quote: '1.2rem' }}
      />
    </div>
  </section>

  <!-- COSTURA VERTICAL · Equipa → Contacto. Mesma cor, mesmo capítulo
       ("Pessoas"): um fio vertical laranja que UNE (não corta), no idioma do
       .seam original. Da família .stitch, cresce com o scroll via --draw. -->
  <div class="stitch stitch--vseam"></div>

  <!-- CONTACTO -->
  <section class="section section--tight-top" id="contacto">
    <div class="container">
      <ContactForm eyebrow={home.contacto.eyebrow} title={home.contacto.title} texto={home.contacto.texto} />
    </div>
  </section>

  </div><!-- /.home-reveal -->

  <!-- O script que anima as costuras (stitch-scroll) vive no Base.astro,
       partilhado por todas as páginas. -->
</Base>
