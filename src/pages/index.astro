---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DoubleSlider from '../components/DoubleSlider.astro';
import ExpandPanels from '../components/ExpandPanels.astro';
import BlockHead from '../components/BlockHead.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Watermark from '../components/Watermark.astro';
import Blob from '../components/Blob.astro';
import TitleSplit from '../components/TitleSplit.astro';
import Seam from '../components/Seam.astro';
import home from '../data/home.json';
import { porGrupo, emDestaque } from '../utils/projetos.js';
import { urlAbsoluto } from '../utils/seo.js';
import { listaDeImoveis } from '../utils/schema.js';

// O título "O Que Fazemos" ("Qualidade — Conforto — Sustentabilidade") vira
// lista numerada (ver .dofazemos__words) em vez de frase corrida — cada
// palavra à volta dos travessões é o seu próprio item.
const fazemosWords = home.oQueFazemos.title.split(/\s*—\s*/);

// Destaques derivados da fonte única — em construção e em projeto no slider,
// concluídos no histórico.
const destaques = emDestaque(8);
const concluidos = porGrupo('concluido').slice(0, 5);

/* SEO: título e descrição vêm do src/data/seo.json pelo caminho ("/"). Aqui só
   se acrescenta o que depende dos dados — a lista de empreendimentos em
   destaque, que dá ao Google a ponte da home para as 17 fichas. */
const schemaHome = [
  listaDeImoveis(destaques, {
    url: urlAbsoluto('/'),
    nome: 'Empreendimentos AM Santos em destaque',
  }),
];
---
<Base schemaExtra={schemaHome} preloadImagem={home.hero.imagem}>
  <Hero title={home.hero.title} image={home.hero.imagem} titleI18n="home.hero.title" />

  <!-- Camada que sobe e cobre a hero fixa (sticky reveal). Fundo opaco para a
       imagem estática só se ver na hero, nunca por trás das secções. -->
  <div class="home-reveal">

  <!-- GRUPO 1 · IDENTIDADE — "Quem Somos" e "Contadores" seguem-se aqui
       (espaçamento curto entre ambos). "O Que Fazemos" passou a fechar o
       capítulo da Obra, a seguir ao Portfolio (ver abaixo). -->

  <!-- QUEM SOMOS -->
  <section class="section section--tight-bottom quemsomos">
    <div class="container">
      <div class="quemsomos__intro has-wm">
        <Watermark variant="line" side="r" size="lg" y="bottom" />
        <TitleSplit text={home.quemSomos.title} class="title-split--center" data-i18n="home.quemSomos.title" data-i18n-split="1" />
      </div>

      <!-- Bloco editorial: meta à esquerda (grid de dados), parágrafo único à
           direita, alinhado à mesma linha do topo da meta e a preencher todo
           o espaço que sobra na grelha de 12 colunas. -->
      <div class="quemsomos__editorial">
        <div class="quemsomos__meta">
          {home.quemSomos.meta.map((m, i) => (
            <div class="qmeta">
              <span class="qmeta__v" data-i18n={`home.quemSomos.meta.${i}.value`}>{m.value}</span>
              <span class="qmeta__l" data-i18n={`home.quemSomos.meta.${i}.label`}>{m.label}</span>
            </div>
          ))}
        </div>
        <p class="quemsomos__p" data-i18n="home.quemSomos.paragrafo">{home.quemSomos.paragrafo}</p>
      </div>

      <!-- CTA no canto inferior direito do bloco de texto, antes da imagem. -->
      <div class="quemsomos__cta">
        <a class="btn" href="/sobre-nos" data-i18n="home.quemSomos.botao">{home.quemSomos.botao}</a>
      </div>
    </div>
    <div class="quemsomos__media reveal-rise-slow">
      {home.quemSomos.imagem
        ? <img class="quemsomos__img" src={home.quemSomos.imagem} alt="Fachada de empreendimento AM Santos" loading="lazy" />
        : <div class="ph" data-label="Imagem 16:9"></div>}
    </div>
  </section>

  <!-- CONTADORES — entre o "Quem Somos" e o Portfolio: os números abrem o
       capítulo da Obra antes dos empreendimentos. Layout a duas colunas (ver
       estudiobase2.com): texto grande alinhado à esquerda de um lado,
       contadores grandes do outro. Os contadores continuam a usar
       .fact__v[data-target] para o main.js animar.
       Secção branca de propósito: um intervalo claro entre o "Quem Somos" e
       o bloco escuro do Portfolio.
       A .seam abre a secção (fronteira entre capítulos), sempre reta
       (sem cunha diagonal). -->
  <section class="section section--seam-top">
    <Seam label="Em Números" variant="light" loose i18n="common.seam.emNumeros" />
    <div class="container">
      <div class="contadores">
        <div class="contadores__text">
          <TitleSplit text={home.oQueFazemos.statsTitle} data-i18n="home.oQueFazemos.statsTitle" data-i18n-split="1" />
          <p class="lead" data-i18n="home.oQueFazemos.statsLead">{home.oQueFazemos.statsLead}</p>
        </div>
        <div class="facts facts--contadores">
          {home.oQueFazemos.stats.map((s, i) => (
            <div class="fact">
              {s.target != null && s.target !== ''
                ? <span class="fact__v" data-target={s.target} data-prefix={s.prefix} data-suffix={s.suffix}>0</span>
                : <span class="fact__v">{s.value}</span>}
              <span class="fact__r" data-i18n={`home.oQueFazemos.stats.${i}.label`}>{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- GRUPO 2 · OBRA — portfolio, "o que fazemos" e histórico partilham o
       bloco escuro e encostam-se, para se lerem como um único capítulo. -->

  <!-- PORTFOLIO — abre o capítulo da Obra. -->
  <section class="section section--dark section--flush">
    <DoubleSlider
      projetos={destaques}
      titulo={home.portfolio.title}
      botao={home.portfolio.botao}
      href="/portfolio"
    />
  </section>

  <!-- O QUE FAZEMOS — entre o Portfolio e o Histórico: fecha a apresentação
       dos empreendimentos com os pilares de atuação antes do track record.
       Sobre o mesmo branco que fecha o capítulo da Obra. O laranja vive nos
       números, em toda a página, em vez de saturar uma só secção. A .seam
       abre a secção (fronteira reta, sem cunha, com o Portfolio) e já dá o
       respiro do topo (ver section--seam-top). -->
  <section class="section section--fazemos section--seam-top section--tight-bottom">
    <Seam label="O Que Fazemos" variant="light" loose i18n="common.seam.oQueFazemos" />
    <div class="container dofazemos">
      <div class="dofazemos__head">
        <h2 class="dofazemos__words">
          {fazemosWords.map((w, i) => (
            <span class="dofazemos__word">
              <span class="dofazemos__word-n">0{i + 1}</span>
              <span class="dofazemos__word-t">{w}</span>
            </span>
          ))}
        </h2>
        <p class="dofazemos__lead" data-i18n="home.oQueFazemos.lead">{home.oQueFazemos.lead}</p>
      </div>
    </div>
    <!-- Três pilares em colunas desalinhadas — cada um começa numa coluna e
         numa altura diferente (ver .pilar--n), sem seguir a mesma linha de
         base, tal como as fases de "O Que Fazemos" do site de referência. -->
    <div class="container">
      <div class="dofazemos__pilares">
        {home.oQueFazemos.pilares.map((p, i) => (
          <div class={`pilar pilar--${i + 1}`}>
            <span class="pilar__n">0{i + 1}</span>
            <h3 class="pilar__t" data-i18n={`home.oQueFazemos.pilares.${i}.title`}>{p.title}</h3>
            <p class="pilar__x" data-i18n={`home.oQueFazemos.pilares.${i}.texto`}>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CORRIDA ESCURA · Histórico + Perguntas Frequentes — as duas secções
       escuras encostam-se e lêem-se como um só bloco de cor (mesmo esquema
       da antiga secção Equipa, que agora vive em /equipa). Por isso o
       <Blob> não vive dentro de cada uma (dava quatro cantos, dois deles
       colados na fronteira interna, denunciando a costura): vive aqui, na
       corrida, e mede-se pela altura das duas juntas. O fundo escuro
       também sobe para cá: --dark é semitransparente e duas camadas
       empilhadas escureceriam a junta (ver .dark-run em styles.css). -->
  <div class="dark-run has-blob">
    <Blob />

    <!-- TRACK RECORD (Histórico) — a .seam abre a secção (fronteira reta
         com o bloco claro atrás) na variante escura — já dentro do preto,
         é ela que dá o respiro do topo (ver .section--panels-cut.section--seam-top). -->
    <section class="section section--dark section--panels-cut section--seam-top">
      <Seam label="O Nosso Histórico" variant="dark" i18n="common.seam.oNossoHistorico" />
      <div class="container">
        <BlockHead title={home.trackRecord.title} lead={home.trackRecord.lead} titleClass="title-split--center" titleI18n="home.trackRecord.title" leadI18n="home.trackRecord.lead" />
      </div>
      <!-- Fora do .container de propósito: os painéis sangram de bordo a bordo
           (ver .section--panels-cut). -->
      <ExpandPanels projetos={concluidos} />

      <!-- CTA do Histórico: fica já dentro da área escura, encostado à direita. -->
      <div class="panels-cta">
        <div class="container">
          <a class="btn" href="/portfolio" data-i18n="home.trackRecord.botao">{home.trackRecord.botao}</a>
        </div>
      </div>
    </section>

    <!-- PERGUNTAS FREQUENTES — ocupa o lugar onde vivia a secção "A Nossa
         Equipa" (mudou-se para a página /equipa, acessível pelo cabeçalho e
         rodapé): mesmo esquema de cor escura, sem marca de água (a secção
         é só título, texto e a lista de perguntas). Em vez de repetir quem
         somos, responde a quem chega ao fundo da home ainda a decidir: o
         que faz uma empresa de empreendimentos e o que distingue a AM
         Santos de outra qualquer. -->
    <section class="section section--dark section--seam-top">
      <Seam label="Perguntas Frequentes" variant="dark" i18n="common.seam.perguntasFrequentes" />
      <div class="container">
        <TitleSplit text={home.faq.title} class="title-split--fit" data-i18n="home.faq.title" data-i18n-split="1" />
        <p class="lead" style="margin:1rem 0 0" data-i18n="home.faq.lead">{home.faq.lead}</p>
        <Faq items={home.faq.items} i18nBase="home.faq.items" />
      </div>
    </section>

  </div><!-- /.dark-run -->

  <!-- CONTACTO — a .seam abre a secção: sem mudança de cor no próprio
       bloco (esta vive já sobre o branco do .home-reveal), fecha a home. -->
  <section class="section section--seam-top" id="contacto">
    <Seam label="Fala Connosco" variant="light" loose i18n="common.seam.falaConnosco" />
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" y="bottom" />
      <ContactForm title={home.contacto.title} texto={home.contacto.texto} titleI18n="home.contacto.title" textoI18n="home.contacto.texto" />
    </div>
  </section>

  </div><!-- /.home-reveal -->
</Base>
