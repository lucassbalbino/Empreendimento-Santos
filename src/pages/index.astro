---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DoubleSlider from '../components/DoubleSlider.astro';
import ExpandPanels from '../components/ExpandPanels.astro';
import BlockHead from '../components/BlockHead.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import Watermark from '../components/Watermark.astro';
import TitleSplit from '../components/TitleSplit.astro';
import home from '../data/home.json';
import { porGrupo, emDestaque } from '../utils/projetos.js';

// Mantém o <em> do meio do título "O Que Fazemos" como no mockup original.
const fazemosTitle = home.oQueFazemos.title.replace(/—\s*(\S+)\s*—/, '— <em>$1</em> —');

// Destaques derivados da fonte única — em construção e em projeto no slider,
// concluídos no histórico.
const destaques = emDestaque(8);
const concluidos = porGrupo('concluido').slice(0, 5);

// Equipa como carrossel: cada card é um membro (foto | nome | cargo | bio).
const equipaCards = home.equipa.members.map((m) => ({
  quote: m.bio,
  name: m.name,
  designation: m.role,
  src: m.foto || '',
}));
---
<Base title="Mockup — Início" description="AM Santos — construindo o futuro com qualidade e sustentabilidade. 20 anos de experiência, com uma equipa de arquitetura, engenharia, decoração e gestão imobiliária.">
  <Hero title={home.hero.title} image={home.hero.imagem} />

  <!-- Camada que sobe e cobre a hero fixa (sticky reveal). Fundo opaco para a
       imagem estática só se ver na hero, nunca por trás das secções. -->
  <div class="home-reveal">

  <!-- GRUPO 1 · IDENTIDADE — "Quem Somos" e "O Que Fazemos" são o mesmo
       capítulo, por isso encostam-se (espaçamento curto entre ambos). -->

  <!-- QUEM SOMOS -->
  <section class="section section--tight-top section--tight-bottom quemsomos">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="lg" y="bottom" />
      <div class="quemsomos__intro">
        <TitleSplit text={home.quemSomos.title} class="title-split--center" />
        <a class="btn" href="/sobre-nos">{home.quemSomos.botao}</a>
      </div>
    </div>
    <div class="quemsomos__media reveal-rise-slow">
      {home.quemSomos.imagem
        ? <img class="quemsomos__img" src={home.quemSomos.imagem} alt="Fachada de empreendimento AM Santos" loading="lazy" />
        : <div class="ph" data-label="Imagem 16:9"></div>}
    </div>
  </section>

  <!-- O QUE FAZEMOS — sobre o mesmo branco do "Quem Somos": os dois são o
       mesmo capítulo. O laranja vive nos números, em toda a página, em vez
       de saturar uma só secção. -->
  <section class="section section--fazemos has-wm">
    <Watermark variant="fill" side="l" size="lg" y="bottom" />
    <div class="container dofazemos">
      <h2 class="display" set:html={fazemosTitle}></h2>
    </div>
  </section>

  <!-- COSTURA · fronteira de cor branco → escuro. Triângulo branco (cor da
       secção anterior) desce sobre o topo do Portfolio, cortando a fronteira na
       diagonal. Fica fora de <section> para escapar à cortina de revelação. -->
  <div class="stitch stitch--light">
    <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <polygon class="stitch__wedge" points="0,0 1000,0 0,60"></polygon>
    </svg>
  </div>

  <!-- GRUPO 2 · OBRA — portfolio, contadores e histórico partilham o bloco
       escuro e encostam-se, para se lerem como um único capítulo. -->

  <!-- PORTFOLIO — abre o capítulo da Obra. -->
  <section class="section section--dark section--flush">
    <DoubleSlider
      projetos={destaques}
      titulo={home.portfolio.title}
      botao={home.portfolio.botao}
      href="/portfolio"
    />
  </section>

  <!-- CONTADORES — entre o Portfolio e o Histórico: os números são a
       credencial que fecha a apresentação dos empreendimentos antes do
       track record. Layout a duas colunas (ver estudiobase2.com): texto
       grande alinhado à esquerda de um lado, contadores grandes do outro —
       em vez do cartão pequeno/centrado anterior. Os contadores continuam a
       usar .fact__v[data-target] para o main.js animar; só o dimensionamento
       e a moldura mudaram.
       Sem tight-top: a margem negativa do .dslider (Portfolio) já puxa esta
       secção para cima do stitch-rise, o que basta para as duas se lerem
       coladas no mesmo bloco escuro. Sem tight-bottom: o Histórico a seguir
       (já noutra secção, além da costura) precisa do respiro normal. -->
  <section class="section section--dark">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="lg" y="bottom" />
      <div class="contadores">
        <div class="contadores__text">
          <TitleSplit text={home.oQueFazemos.statsTitle} />
          <p class="lead">{home.oQueFazemos.statsLead}</p>
        </div>
        <div class="facts facts--contadores">
          {home.oQueFazemos.stats.map((s) => (
            <div class="fact">
              {s.target != null && s.target !== ''
                ? <span class="fact__v" data-target={s.target} data-prefix={s.prefix} data-suffix={s.suffix}>0</span>
                : <span class="fact__v">{s.value}</span>}
              <span class="fact__r">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- COSTURA · fronteira de cor escuro → branco (Contadores → Histórico).
       Triângulo escuro (cor dos Contadores) desce sobre o topo branco do
       Histórico, cortando a fronteira na diagonal. Fora de <section>
       para escapar à cortina de revelação. -->
  <div class="stitch stitch--dark">
    <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <polygon class="stitch__wedge" points="0,0 1000,0 0,60"></polygon>
    </svg>
  </div>

  <!-- TRACK RECORD (Histórico) — secção branca autónoma: sai do bloco escuro
       da Obra, com mais respiro no topo. Ver .section--panels-cut. -->
  <section class="section section--panels-cut">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="lg" y="bottom" />
      <BlockHead title={home.trackRecord.title} lead={home.trackRecord.lead} titleClass="title-split--fill" />
    </div>
    <!-- Fora do .container de propósito: os painéis sangram de bordo a bordo e
         descem para dentro da costura diagonal (ver .section--panels-cut). -->
    <ExpandPanels projetos={concluidos} />
  </section>

  <!-- COSTURA · fronteira de cor branco → cinza (Histórico → Equipa).
       Triângulo branco (cor do Histórico) desce sobre o topo do bloco seguinte,
       cortando a fronteira na diagonal. Os painéis (z7) descem RENTES a esta
       diagonal, sobre a cunha (z6). Ver .section--panels-cut. -->
  <div class="stitch stitch--light">
    <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <polygon class="stitch__wedge" points="0,0 1000,0 0,60"></polygon>
    </svg>
  </div>

  <!-- CTA do Histórico: vive ABAIXO da costura, já no cinza, encostado à
       direita (o lado onde a diagonal está rente à fronteira). -->
  <div class="panels-cta">
    <div class="container">
      <a class="btn" href="/portfolio">{home.trackRecord.botao}</a>
    </div>
  </div>

  <!-- GRUPO 3 · PESSOAS — equipa e contacto encostam-se: conhecer quem
       faz e falar com quem faz são o mesmo movimento. -->

  <!-- EQUIPA (carrossel: cada card é um membro) -->
  <section class="section section--alt section--tight-top section--tight-bottom">
    <div class="container has-wm">
      <TitleSplit text={home.equipa.title} style="margin-bottom:clamp(32px,4vw,56px)" />
      <Testimonials
        testimonials={equipaCards}
        autoplay={true}
        colors={{
          name: 'var(--ink)',
          designation: 'var(--ink-faint)',
          testimony: 'var(--ink-soft)',
          arrowBackground: 'var(--dark)',
          arrowForeground: 'var(--paper)',
          arrowHoverBackground: 'var(--accent)',
        }}
        fontSizes={{ name: '1.9rem', designation: '0.8rem', quote: '1.2rem' }}
      />
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section section--tight-top" id="contacto">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" y="bottom" />
      <ContactForm title={home.contacto.title} texto={home.contacto.texto} />
    </div>
  </section>

  </div><!-- /.home-reveal -->
</Base>
