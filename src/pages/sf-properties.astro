---
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import sf from '../data/sf-properties.json';
import { todos } from '../utils/projetos.js';

// A SF Properties faz a mediação dos residenciais do grupo que ainda não estão concluídos.
const residenciais = todos
  .filter((p) => p.grupo !== 'concluido' && !p.tipologia.startsWith('Armazéns') && !p.tipologia.startsWith('Hotel'))
  .sort((a, b) => a.ano - b.ano);
---
<Base title="Mockup — SF Properties" description="SF Properties — estabelecer o padrão de excelência no sector imobiliário. Um conjunto completo de serviços sob o mesmo teto, do investimento à gestão de propriedades.">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:80vh">
    <div class="hero__bg"></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <span class="eyebrow" style="color:#d29a5a">{sf.hero.eyebrow}</span>
        <h1 class="display hero__title-page">{sf.hero.title}</h1>
      </div>
    </div>
  </section>

  <!-- SOBRE A MARCA -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__media"><div class="ph" data-label="Imagem 4:5"></div></div>
        <div class="split__body">
          <span class="eyebrow">{sf.sobre.eyebrow}</span>
          <h2 class="display display--sm">{sf.sobre.title}</h2>
          <p class="lead" style="margin:1rem 0 1.4rem">{sf.sobre.lead}</p>
          <p>{sf.sobre.paragrafo}</p>
          {sf.sobre.botao && <a class="btn" href="#" style="margin-top:1.6rem">{sf.sobre.botao}</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">{sf.servicos.eyebrow}</span>
      <h2 class="display display--sm" style="margin-bottom:clamp(40px,5vw,72px)">{sf.servicos.title}</h2>
      <span class="eyebrow">{sf.servicos.gamaTitle}</span>
      <ul class="svc-list">
        {sf.servicos.gama.map((g) => (<li class="svc-list__item">{g}</li>))}
      </ul>
      {sf.servicos.items.map((s) => (
        <div class="service">
          <div class="service__media"><div class="ph" data-label="Imagem 5:4"></div></div>
          <div class="service__body">
            <h3>{s.title}</h3>
            <p>{s.texto}</p>
            {s.botao && <a class="btn" href="#">{s.botao}</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PROJETOS EM DESTAQUE -->
  <section class="section">
    <div class="container">
      <BlockHead eyebrow={sf.projetos.eyebrow} title={sf.projetos.title} lead={sf.projetos.lead} />
      <div class="grid-projects">
        {residenciais.map((p) => (<ProjectCard proj={p} />))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section section--alt" id="contacto">
    <div class="container">
      <ContactForm eyebrow={sf.contacto.eyebrow} title={sf.contacto.title} texto={sf.contacto.texto} />
    </div>
  </section>
</Base>
