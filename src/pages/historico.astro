---
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Stitch from '../components/Stitch.astro';
import historico from '../data/historico.json';
import { porGrupo } from '../utils/projetos.js';

const concluidos = porGrupo('concluido');

// Dados que a janela modal precisa (populada por JS a partir do data-slug do card).
const modalData = concluidos.map((p) => ({
  slug: p.slug,
  nome: p.nome,
  localizacao: p.localizacao,
  tipologia: p.tipologia,
  ano: p.ano,
  unidades: p.unidades,
  estado: p.estado,
  entrega: p.entrega,
  resumo: p.resumo,
  imagem: p.imagem,
  imagemReal: p.imagemReal,
  factos: p.factos,
}));
---
<Base title="Mockup — Histórico" description="O percurso da AM Santos: uma seleção de empreendimentos concluídos e entregues ao longo de 20 anos no mercado imobiliário.">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:80vh">
    <div
      class={historico.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={historico.hero.imagem ? `background-image:url(${historico.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <span class="eyebrow" style="color:var(--accent-dk)">{historico.hero.eyebrow}</span>
        <h1 class="display hero__title-page">{historico.hero.title}</h1>
      </div>
    </div>
  </section>

  <!-- PROJETOS CONCLUÍDOS -->
  <section class="section">
    <div class="container">
      <BlockHead eyebrow={historico.concluidos.eyebrow} title={historico.concluidos.title} lead={historico.concluidos.lead} />
      <div class="grid-projects">
        {concluidos.map((p) => (<ProjectCard proj={p} modal={true} />))}
      </div>
    </div>
  </section>

  <!-- COSTURA · Concluídos (branco) → Contacto (cinza) -->
  <Stitch variant="light" />

  <!-- CONTACTO -->
  <section class="section section--alt" id="contacto">
    <div class="container">
      <ContactForm eyebrow={historico.contacto.eyebrow} title={historico.contacto.title} texto={historico.contacto.texto} />
    </div>
  </section>

  <!-- JANELA MODAL DO EMPREENDIMENTO (aberta pelos cards acima) -->
  <div class="emodal" id="emodal" hidden>
    <div class="emodal__backdrop" data-emodal-close></div>
    <div class="emodal__dialog" role="dialog" aria-modal="true" aria-labelledby="emodal-title">
      <!-- Painel esquerdo: imagem + título + specs rápidas -->
      <div class="emodal__media">
        <img class="emodal__img" id="emodal-img" src="" alt="" />
        <span class="img-prov" id="emodal-prov" hidden>Imagem provisória</span>
        <div class="emodal__media-grad"></div>
        <div class="emodal__media-head">
          <h2 class="emodal__title" id="emodal-title"></h2>
          <p class="emodal__subtitle" id="emodal-subtitle"></p>
        </div>
        <div class="emodal__chips" id="emodal-chips"></div>
      </div>
      <!-- Painel direito: informação sobre o projeto -->
      <div class="emodal__info">
        <button class="emodal__close" type="button" data-emodal-close aria-label="Fechar">&times;</button>
        <span class="eyebrow" id="emodal-eyebrow"></span>
        <h3 class="emodal__info-title">Sobre o empreendimento</h3>
        <p class="emodal__resumo" id="emodal-resumo"></p>
        <div class="emodal__facts" id="emodal-facts"></div>
        <div class="emodal__footer">
          <span class="emodal__entrega" id="emodal-entrega"></span>
          <a class="btn" href="/contactos">Falar connosco</a>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="emodal-data" set:html={JSON.stringify(modalData)}></script>

  <script is:inline>
    (function () {
      var modal = document.getElementById('emodal');
      var dataEl = document.getElementById('emodal-data');
      if (!modal || !dataEl) return;

      var projetos = {};
      try {
        JSON.parse(dataEl.textContent).forEach(function (p) { projetos[p.slug] = p; });
      } catch (e) { return; }

      var el = {
        img: document.getElementById('emodal-img'),
        prov: document.getElementById('emodal-prov'),
        title: document.getElementById('emodal-title'),
        subtitle: document.getElementById('emodal-subtitle'),
        chips: document.getElementById('emodal-chips'),
        eyebrow: document.getElementById('emodal-eyebrow'),
        resumo: document.getElementById('emodal-resumo'),
        facts: document.getElementById('emodal-facts'),
        entrega: document.getElementById('emodal-entrega'),
        dialog: modal.querySelector('.emodal__dialog'),
        close: modal.querySelector('.emodal__close'),
      };

      var lastFocus = null;

      function chip(text) {
        var s = document.createElement('span');
        s.className = 'emodal__chip';
        s.textContent = text;
        return s;
      }

      function factRow(rotulo, valor) {
        var row = document.createElement('div');
        row.className = 'emodal__fact';
        var l = document.createElement('span');
        l.className = 'emodal__fact-label';
        l.textContent = rotulo;
        var v = document.createElement('span');
        v.className = 'emodal__fact-value';
        v.textContent = valor;
        row.appendChild(l);
        row.appendChild(v);
        return row;
      }

      function fill(p) {
        el.img.src = p.imagem || '';
        el.img.alt = p.nome;
        el.prov.hidden = !(p.imagem && !p.imagemReal);
        el.title.textContent = p.nome;
        el.subtitle.textContent = [p.localizacao, p.tipologia].filter(Boolean).join(' · ');
        el.eyebrow.textContent = p.estado || 'Empreendimento';
        el.resumo.textContent = p.resumo || '';
        el.entrega.textContent = p.entrega || '';

        el.chips.textContent = '';
        [p.ano, p.unidades, p.tipologia].forEach(function (v) {
          if (v) el.chips.appendChild(chip(String(v)));
        });

        el.facts.textContent = '';
        (p.factos || []).forEach(function (f) {
          el.facts.appendChild(factRow(f.rotulo, f.valor));
        });
      }

      function open(slug, trigger) {
        var p = projetos[slug];
        if (!p) return;
        fill(p);
        lastFocus = trigger || null;
        modal.hidden = false;
        document.documentElement.classList.add('emodal-open');
        el.dialog.scrollTop = 0;
        var info = modal.querySelector('.emodal__info');
        if (info) info.scrollTop = 0;
        el.close.focus();
      }

      function close() {
        modal.hidden = true;
        document.documentElement.classList.remove('emodal-open');
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
        lastFocus = null;
      }

      document.querySelectorAll('.card--modal').forEach(function (card) {
        card.addEventListener('click', function () { open(card.getAttribute('data-slug'), card); });
      });

      modal.querySelectorAll('[data-emodal-close]').forEach(function (btn) {
        btn.addEventListener('click', close);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) close();
      });
    })();
  </script>
</Base>
