---
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import Stats from '../components/Stats.astro';
import ContactForm from '../components/ContactForm.astro';
import historico from '../data/historico.json';
---
<Base title="Mockup — Histórico">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:62vh">
    <div class="hero__bg"></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <span class="eyebrow" style="color:#c8a878">{historico.hero.eyebrow}</span>
        <h1 class="display hero__title-page">{historico.hero.title}</h1>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section">
    <div class="container">
      <BlockHead eyebrow={historico.intro.eyebrow} title={historico.intro.title} lead={historico.intro.lead} />
    </div>
  </section>

  <!-- NÚMEROS -->
  <section class="section section--dark">
    <div class="container">
      <span class="eyebrow">{historico.stats.eyebrow}</span>
      <h2 class="display display--sm" style="margin-bottom:clamp(40px,5vw,72px)">{historico.stats.title}</h2>
      <Stats items={historico.stats.items} />
    </div>
  </section>

  <!-- PROJETOS CONCLUÍDOS -->
  <section class="section">
    <div class="container">
      <div class="grid-projects">
        {historico.projetos.map((p) => (
          <article class="card">
            <div class="card__media">
              <div class="ph"></div>
              <div class="card__overlay">
                <h3 class="card__title">{p.nome}</h3>
                <div class="card__meta">{p.localizacao} · {p.tipologia}</div>
                {p.cta && <span class="card__cta">{p.cta}</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section section--alt" id="contacto">
    <div class="container">
      <ContactForm eyebrow={historico.contacto.eyebrow} title={historico.contacto.title} texto={historico.contacto.texto} />
    </div>
  </section>
</Base>
