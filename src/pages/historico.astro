---
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Watermark from '../components/Watermark.astro';
import Seam from '../components/Seam.astro';
import historico from '../data/historico.json';
import { porGrupo } from '../utils/projetos.js';
import { urlAbsoluto } from '../utils/seo.js';
import { listaDeImoveis } from '../utils/schema.js';

const concluidos = porGrupo('concluido');

const schemaHistorico = [
  listaDeImoveis(concluidos, {
    url: urlAbsoluto('/historico'),
    nome: 'Empreendimentos AM Santos concluídos e entregues',
  }),
];

// Dados que a janela modal precisa (populada por JS a partir do data-slug do card).
const modalData = concluidos.map((p) => ({
  slug: p.slug,
  nome: p.nome,
  localizacao: p.localizacao,
  tipologia: p.tipologia,
  ano: p.ano,
  unidades: p.unidades,
  estado: p.estado,
  entrega: p.entrega,
  resumo: p.resumo,
  imagem: p.imagem,
  imagemReal: p.imagemReal,
  galeria: p.galeria,
  factos: p.factos,
}));
---
<Base flat tipoPagina="CollectionPage" schemaExtra={schemaHistorico}>
  <!-- PROJETOS CONCLUÍDOS. Como o portfólio: sem hero — a .seam--top, na
       mesma .container do título, funciona como eyebrow do h1 logo a seguir
       (a página abre direto no bloco de cards: fade branco na entrada,
       cabeçalho centrado e slide pesado). -->
  <section class="section section--centered-head section--flat-top">
    <div class="container">
      <Seam label={historico.hero.title} variant="light" class="seam--top" i18n="historico.hero.title" bare />
      <BlockHead title={historico.concluidos.title} lead={historico.concluidos.lead} as="h1" titleI18n="historico.concluidos.title" leadI18n="historico.concluidos.lead" />
      <div class="grid-projects">
        {concluidos.map((p) => (<ProjectCard proj={p} modal={true} />))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section section--alt" id="contacto">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" y="bottom" />
      <ContactForm title={historico.contacto.title} texto={historico.contacto.texto} titleI18n="historico.contacto.title" textoI18n="historico.contacto.texto" />
    </div>
  </section>

  <!-- PAINEL INLINE DO EMPREENDIMENTO. Vive aqui escondido; ao clicar num card
       o JS insere-o na grelha, a seguir ao último card da linha do card clicado. -->
  <div id="epanel-holder" hidden>
    <div class="epanel" id="epanel" hidden>
      <div class="epanel__wrap">
        <div class="epanel__inner" role="region" aria-labelledby="emodal-title">
          <!-- Painel esquerdo: imagem + título + specs rápidas -->
          <div class="emodal__media">
            <img class="emodal__img" id="emodal-img" src="" alt="" />
            <span class="img-prov" id="emodal-prov" hidden data-i18n="common.emodal.provisoria">Imagem provisória</span>
            <div class="emodal__media-grad"></div>
            <!-- Navegação da galeria: só aparece quando há mais do que uma
                 imagem (ver updateGalleryUI). Mesmas setas do PlansSlider,
                 numa versão discreta — círculo translúcido sobre a foto. -->
            <button class="emodal__nav emodal__nav--prev" id="emodal-prev" type="button" hidden aria-label="Imagem anterior" data-i18n="common.plans.prev" data-i18n-attr="aria-label">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m0 0 6-6m-6 6 6 6"/></svg>
            </button>
            <button class="emodal__nav emodal__nav--next" id="emodal-next" type="button" hidden aria-label="Imagem seguinte" data-i18n="common.plans.next" data-i18n-attr="aria-label">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m0 0-6-6m6 6-6 6"/></svg>
            </button>
            <span class="emodal__counter" id="emodal-counter" hidden aria-hidden="true"></span>
            <div class="emodal__media-head">
              <h2 class="emodal__title" id="emodal-title"></h2>
              <p class="emodal__subtitle" id="emodal-subtitle"></p>
            </div>
            <div class="emodal__chips" id="emodal-chips"></div>
          </div>
          <!-- Painel direito: informação sobre o projeto -->
          <div class="emodal__info">
            <button class="emodal__close" type="button" data-emodal-close aria-label="Fechar" data-i18n="common.emodal.close" data-i18n-attr="aria-label">&times;</button>
            <span class="emodal__estado" id="emodal-estado"></span>
            <h3 class="emodal__info-title" data-i18n="common.emodal.sobre">Sobre o empreendimento</h3>
            <p class="emodal__resumo" id="emodal-resumo"></p>
            <div class="emodal__facts" id="emodal-facts"></div>
            <div class="emodal__footer">
              <span class="emodal__entrega" id="emodal-entrega"></span>
              <a class="btn" href="/contactos" data-i18n="common.emodal.falarConnosco">Falar connosco</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="emodal-data" set:html={JSON.stringify(modalData)}></script>

  <script is:inline>
    (function () {
      var panel = document.getElementById('epanel');
      var holder = document.getElementById('epanel-holder');
      var grid = document.querySelector('.grid-projects');
      var dataEl = document.getElementById('emodal-data');
      if (!panel || !holder || !grid || !dataEl) return;

      var projetos = {};
      try {
        JSON.parse(dataEl.textContent).forEach(function (p) { projetos[p.slug] = p; });
      } catch (e) { return; }

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var DUR = 1830; // ligeiramente acima da transição CSS de .epanel__wrap (1.3s)
      var CLOSE_MS = 400;    // fecho bem mais rápido do que a abertura (1.3s)
      var CLOSE_DUR = 420;   // ligeiramente acima do CLOSE_MS, para o setTimeout nunca correr antes da transição acabar

      var el = {
        img: document.getElementById('emodal-img'),
        prov: document.getElementById('emodal-prov'),
        title: document.getElementById('emodal-title'),
        subtitle: document.getElementById('emodal-subtitle'),
        chips: document.getElementById('emodal-chips'),
        estado: document.getElementById('emodal-estado'),
        resumo: document.getElementById('emodal-resumo'),
        facts: document.getElementById('emodal-facts'),
        entrega: document.getElementById('emodal-entrega'),
        close: panel.querySelector('.emodal__close'),
        prev: document.getElementById('emodal-prev'),
        next: document.getElementById('emodal-next'),
        counter: document.getElementById('emodal-counter'),
      };

      var currentCard = null;   // card cujo painel está aberto (ou a fechar)
      var closeTimer = null;
      var openTimer = null;     // correção de scroll agendada (linhas clampadas)
      var gallery = [];         // imagens do projeto em exibição (imagem + galeria)
      var galleryIndex = 0;

      function chip(text) {
        var s = document.createElement('span');
        s.className = 'emodal__chip';
        s.textContent = text;
        return s;
      }

      function factRow(rotulo, valor) {
        var row = document.createElement('div');
        row.className = 'emodal__fact';
        var l = document.createElement('span');
        l.className = 'emodal__fact-label';
        l.textContent = rotulo;
        var v = document.createElement('span');
        v.className = 'emodal__fact-value';
        v.textContent = valor;
        row.appendChild(l);
        row.appendChild(v);
        return row;
      }

      // Traduz um campo do projeto via dicionário i18n (empreendimentos.<slug>.<campo>),
      // com fallback para o valor PT original vindo do JSON embutido.
      function tp(p, field, fallback) {
        if (!window.__amsI18n) return fallback;
        return window.__amsI18n.get('empreendimentos.' + p.slug + '.' + field, fallback);
      }

      // Mostra a imagem `idx` da galeria (com wrap-around) e actualiza setas
      // + contador. `total <= 1` esconde a navegação — é o que a torna subtil:
      // só aparece quando há mesmo por onde navegar.
      function updateGalleryUI() {
        var total = gallery.length;
        var multi = total > 1;
        el.prev.hidden = !multi;
        el.next.hidden = !multi;
        el.counter.hidden = !multi;
        if (multi) el.counter.textContent = (galleryIndex + 1) + ' / ' + total;
      }

      function showImage(idx, nome) {
        var total = gallery.length;
        if (!total) return;
        galleryIndex = ((idx % total) + total) % total;
        el.img.src = gallery[galleryIndex];
        el.img.alt = (nome || el.title.textContent) + (total > 1 ? ' — imagem ' + (galleryIndex + 1) : '');
        updateGalleryUI();
      }

      function fill(p, resetGallery) {
        var nome = tp(p, 'nome', p.nome);
        var tipologia = tp(p, 'tipologia', p.tipologia);
        var unidades = tp(p, 'unidades', p.unidades);
        var estado = tp(p, 'estado', p.estado);
        var entrega = tp(p, 'entrega', p.entrega);
        var resumo = tp(p, 'resumo', p.resumo);
        var factosValores = window.__amsI18n ? window.__amsI18n.get('empreendimentos.' + p.slug + '.factos', null) : null;

        if (resetGallery !== false) {
          gallery = [p.imagem].concat(p.galeria || []).filter(Boolean);
          galleryIndex = 0;
        }
        el.prov.hidden = !(p.imagem && !p.imagemReal);
        el.title.textContent = nome;
        showImage(galleryIndex, nome);
        el.subtitle.textContent = [p.localizacao, tipologia].filter(Boolean).join(' · ');
        el.estado.textContent = estado || (window.__amsI18n ? window.__amsI18n.get('common.emodal.empreendimentoFallback', 'Empreendimento') : 'Empreendimento');
        el.resumo.textContent = resumo || '';
        el.entrega.textContent = entrega || '';

        el.chips.textContent = '';
        [p.ano, unidades, tipologia].forEach(function (v) {
          if (v) el.chips.appendChild(chip(String(v)));
        });

        el.facts.textContent = '';
        (p.factos || []).forEach(function (f, i) {
          if (f.rotulo === 'Arquitetura' || f.rotulo === 'Estado') return;
          var rotulo = window.__amsI18n ? window.__amsI18n.factLabel(f.rotulo) : f.rotulo;
          var valor = (factosValores && factosValores[i] != null) ? factosValores[i] : f.valor;
          el.facts.appendChild(factRow(rotulo, valor));
        });
      }

      // Se o painel estiver aberto quando o idioma muda, retraduz no lugar.
      if (window.__amsI18n) {
        window.__amsI18n.onChange(function () {
          if (currentCard) {
            var p = projetos[currentCard.getAttribute('data-slug')];
            if (p) fill(p, false); // false: mantém a imagem que estava a ver
          }
        });
      }

      function lenisResize() {
        var l = window.__amsLenis;
        if (l && typeof l.resize === 'function') l.resize();
      }

      // Leva a página até ao painel, centrando-o no espaço visível abaixo do
      // header. Deslize longo com ease-in-out marcado, para um efeito dramático.
      function easeInOutCubic(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }

      // Espaço a reservar no topo: header fixo + folga. O header encolhe quando
      // a página sai do topo (.scrolled) e é esse o estado em que o deslize
      // termina — medir o estado alto (página no topo) deixaria o painel uns
      // 30px abaixo do centro. Daí o teto na altura compacta.
      var HEADER_SCROLLED = 72;
      function headerGap() {
        var h = document.querySelector('.site-header');
        var alt = h ? h.getBoundingClientRect().height : 0;
        return Math.min(alt || HEADER_SCROLLED, HEADER_SCROLLED) + 12;
      }

      // Altura que o painel VAI ter, medida antes de abrir. O acordeão anima a
      // linha da grelha de 0fr a 1fr, por isso durante o deslize a altura real
      // ainda é ~0 — sem esta medição o painel seria centrado por uma altura
      // errada e ficaria baixo de mais. Truque: força 1fr sem transição, lê, e
      // volta a comprometer o estado colapsado no mesmo tick (nada é pintado
      // pelo meio, e a abertura anima na mesma a seguir).
      var panelH = 0;
      function measurePanelHeight() {
        var wrap = panel.querySelector('.epanel__wrap');
        var inner = panel.querySelector('.epanel__inner');
        if (!wrap || !inner) return 0;
        wrap.style.transition = 'none';
        wrap.style.gridTemplateRows = '1fr';
        var h = inner.offsetHeight;
        wrap.style.gridTemplateRows = '';
        void wrap.offsetHeight;        // recompromete 0fr enquanto ainda não há transição
        wrap.style.transition = '';
        return h;
      }

      // Deslocamento a aplicar ao topo do painel (negativo = parar antes dele):
      // centra-o no espaço visível abaixo do header. Painel mais alto do que
      // esse espaço: encosta ao topo, logo abaixo do header.
      function panelOffset() {
        var topo = headerGap();
        var inner = panel.querySelector('.epanel__inner');
        var altura = panelH || (inner ? inner.scrollHeight : panel.offsetHeight);
        var folga = Math.max(0, (window.innerHeight - topo - altura) / 2);
        return -(topo + folga);
      }

      function scrollToPanel() {
        var lenis = window.__amsLenis;
        var alvo = Math.max(0, panelTargetY());
        if (!reduce && lenis && typeof lenis.scrollTo === 'function') {
          // Sem o resize o Lenis clampa o alvo pelo limite que tinha da última
          // vez que mediu a página (que muda a cada abrir/fechar do painel).
          if (typeof lenis.resize === 'function') lenis.resize();
          lenis.scrollTo(alvo, { duration: 1.2, easing: easeInOutCubic });
        } else {
          window.scrollTo({ top: alvo, behavior: reduce ? 'auto' : 'smooth' });
        }
      }

      // Alvo absoluto (posição final do painel) e limite de scroll actuais — para
      // saber se o alvo fica clampado enquanto o painel ainda não expandiu
      // (últimas linhas, em que a página ainda é curta de mais para lá chegar).
      // A conversão para coordenadas do documento usa o scroll REAL (não o do
      // Lenis): quando a página muda de altura o Lenis pode ficar uns pixels
      // dessincronizado, e era isso que deixava o painel abaixo do centro.
      function panelTargetY() {
        return panel.getBoundingClientRect().top + window.scrollY + panelOffset();
      }
      function maxScroll() {
        return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      }

      // Último card na mesma linha visual do card dado (mesmo offsetTop), para o
      // painel de largura total abrir por baixo da linha inteira — em 3/2/1 colunas.
      function lastInRow(card) {
        var cards = grid.querySelectorAll('.card--modal');
        var top = card.offsetTop, last = card;
        for (var i = 0; i < cards.length; i++) {
          if (cards[i].offsetTop === top) last = cards[i];
        }
        return last;
      }

      // Arranca o painel da grelha para o holder, sem animação. Só usado
      // quando não há nenhum painel visível para fechar em transição (1.ª
      // abertura, ou o painel já estava escondido) — nunca para trocar de
      // card com um painel a meio do ecrã.
      function detach() {
        if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
        panel.classList.remove('is-open');
        panel.hidden = true;
        holder.appendChild(panel);
        currentCard = null;
      }

      // Move o painel (já preenchido) para a linha do card e faz a animação
      // de abertura + scroll. Extraído de open() para poder correr de
      // imediato ou só depois de uma animação de fecho terminar.
      function reveal(card, p) {
        fill(p);

        var anchor = lastInRow(card);
        grid.insertBefore(panel, anchor.nextSibling);
        panel.hidden = false;
        panelH = measurePanelHeight();      // altura final, ainda com a linha colapsada
        void panel.offsetHeight;            // reflow: garante o estado 0fr antes de animar
        panel.classList.add('is-open');
        currentCard = card;

        // Scroll imediato (feedback) e, quando o painel acaba de expandir, um
        // resize + scroll de correção — a página já tem a altura final, por isso
        // o alvo deixa de ser clampado mesmo para cards das últimas linhas.
        // Só corrigimos (resize + novo scroll) se o alvo ficou clampado por a
        // página ainda ser curta — assim o deslize dramático não é interrompido
        // a meio nos cards que já alcançam o painel à primeira.
        var clamped = panelTargetY() > maxScroll() + 2;
        scrollToPanel();
        if (openTimer) clearTimeout(openTimer);
        if (clamped) {
          openTimer = setTimeout(function () {
            if (currentCard !== card) return;
            lenisResize();
            scrollToPanel();
            openTimer = null;
          }, reduce ? 0 : DUR);
        }
      }

      function open(card) {
        var p = projetos[card.getAttribute('data-slug')];
        if (!p) return;
        if (card === currentCard) { close(); return; } // toggle

        // Qualquer plano anterior (correção de scroll agendada, fecho a
        // meio) deixa de valer — só a última abertura clicada é que conta.
        if (openTimer) { clearTimeout(openTimer); openTimer = null; }

        if (currentCard) {
          // Já há um painel aberto noutra linha: fecha-o com animação e só
          // move/reabre depois — em vez do salto seco de trocar de sítio a
          // meio do ecrã sem transição.
          close(function () { reveal(card, p); });
        } else if (!panel.hidden && closeTimer) {
          // Painel ainda a meio do fecho (currentCard já é null): cancela o
          // fecho e reaproveita-o já aberto na nova linha.
          clearTimeout(closeTimer);
          closeTimer = null;
          reveal(card, p);
        } else {
          detach();
          reveal(card, p);
        }
      }

      // `after` corre só depois do painel acabar de colapsar — usado para
      // encadear uma reabertura noutra linha sem cortar a animação de fecho.
      function close(after) {
        if (openTimer) { clearTimeout(openTimer); openTimer = null; }
        if (!currentCard) { if (after) after(); return; }
        // Fecho mais rápido do que a abertura: sobrepõe a duração da
        // transição só para este colapso — measurePanelHeight() (chamada na
        // próxima abertura) limpa este inline style, devolvendo o wrap aos
        // 1.3s da folha de estilos antes de a próxima animação de abertura
        // arrancar.
        var wrap = panel.querySelector('.epanel__wrap');
        if (wrap) wrap.style.transition = 'grid-template-rows ' + CLOSE_MS + 'ms var(--ease)';
        panel.classList.remove('is-open');
        currentCard = null;
        if (closeTimer) clearTimeout(closeTimer);
        closeTimer = setTimeout(function () {
          panel.hidden = true;
          holder.appendChild(panel);
          lenisResize();
          closeTimer = null;
          if (after) after();
        }, reduce ? 0 : CLOSE_DUR);
      }

      // Reposiciona o painel na linha certa quando o nº de colunas muda.
      var rT = null;
      window.addEventListener('resize', function () {
        if (!currentCard || panel.hidden) return;
        if (rT) clearTimeout(rT);
        rT = setTimeout(function () {
          if (!currentCard) return;
          var anchor = lastInRow(currentCard);
          if (anchor.nextSibling !== panel) grid.insertBefore(panel, anchor.nextSibling);
          lenisResize();
        }, 150);
      });

      grid.querySelectorAll('.card--modal').forEach(function (card) {
        card.addEventListener('click', function () { open(card); });
      });

      panel.querySelectorAll('[data-emodal-close]').forEach(function (btn) {
        btn.addEventListener('click', function () { close(); });
      });

      el.prev.addEventListener('click', function (e) { e.stopPropagation(); showImage(galleryIndex - 1); });
      el.next.addEventListener('click', function (e) { e.stopPropagation(); showImage(galleryIndex + 1); });

      document.addEventListener('keydown', function (e) {
        if (!currentCard) return;
        if (e.key === 'Escape') { close(); return; }
        if (gallery.length < 2) return;
        if (e.key === 'ArrowLeft') { e.preventDefault(); showImage(galleryIndex - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); showImage(galleryIndex + 1); }
      });

      // ABERTURA DIRETA POR URL — /historico#<slug>. Os painéis do Histórico na
      // home ligam para aqui com o slug no hash: em vez de mandarem o visitante
      // para a página de detalhe, abrem o card na grelha como se ele o tivesse
      // clicado nesta página.
      function openFromHash() {
        var slug = '';
        try { slug = decodeURIComponent((location.hash || '').slice(1)); } catch (e) { return; }
        if (!slug || !projetos[slug]) return;
        var card = grid.querySelector('.card--modal[data-slug="' + slug + '"]');
        if (!card || card === currentCard) return;
        whenReady(function () { open(card); });
      }

      // Só depois de a página estar realmente a ser vista: com o preloader
      // (1.ª carga) ou a cortina (navegação suave) ainda em curso o scroll está
      // travado e o deslize até ao painel perder-se-ia.
      function whenReady(cb) {
        var root = document.documentElement;
        function busy() {
          return root.classList.contains('is-loading') || window.__amsCurtainBusy;
        }
        function go() {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { setTimeout(cb, reduce ? 0 : 260); });
          });
        }
        if (!busy()) { go(); return; }
        var id = setInterval(function () {
          if (busy()) return;
          clearInterval(id);
          go();
        }, 50);
      }

      openFromHash();
    })();
  </script>

  <script is:inline>
    // Entrada pesada do cabeçalho (como o 1.º bloco do portfólio). Só o
    // cabeçalho: os cards mantêm o reveal normal do Base e a modal fica intocada.
    // O CSS gera .section--flat-top .block-head :is(.display,.lead) em
    // opacity:0 até .is-entered — sem este script o cabeçalho fica invisível.
    // Dispara SÓ depois de um frame inicial pintado (gate da cortina / rAF), o
    // que evita o salto na navbar (o bloco está acima da dobra). Init UMA vez; o
    // listener astro:page-load persiste e chama setup em cada nav.
    (function () {
      if (window.__amsHistRise) return;
      window.__amsHistRise = true;
      var root = document.documentElement;

      // FORÇA UM REFLOW antes de .is-entered: compromete o estado escondido
      // (translateY(80px)) como baseline para a transição interpolar a partir daí,
      // em vez de resolver início e fim no mesmo tick (salto seco).
      function enterFirstBlock(first) {
        void first.offsetHeight;
        first.classList.add('is-entered');
      }

      // Espera um frame garantidamente pintado: cortina em curso (navbar) → poll
      // até __amsCurtainBusy voltar a false; carga direta / soft-nav → double-rAF.
      function whenPainted(cb) {
        if (window.__amsCurtainBusy) {
          var id = setInterval(function () {
            if (!window.__amsCurtainBusy) { clearInterval(id); cb(); }
          }, 50);
        } else {
          requestAnimationFrame(function () { requestAnimationFrame(cb); });
        }
      }

      function setup() {
        var reveal = ('IntersectionObserver' in window) && root.classList.contains('reveal-ready');
        var first = document.querySelector('.section--flat-top');
        if (!first || first.dataset.enterBound) return;
        first.dataset.enterBound = '1';
        if (!reveal) {
          first.classList.add('is-entered');       // reduced-motion: assenta já
        } else {
          whenPainted(function () { enterFirstBlock(first); });
        }
      }

      document.addEventListener('astro:page-load', setup);
      setup();
    })();
  </script>
</Base>
