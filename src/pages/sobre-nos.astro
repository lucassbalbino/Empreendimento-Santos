---
import Base from '../layouts/Base.astro';
import Team from '../components/Team.astro';
import ContactForm from '../components/ContactForm.astro';
import Stitch from '../components/Stitch.astro';
import Divider from '../components/Divider.astro';
import Frame from '../components/Frame.astro';
import Watermark from '../components/Watermark.astro';
import TitleSplit from '../components/TitleSplit.astro';
import Stats from '../components/Stats.astro';
import sobre from '../data/sobre.json';
import home from '../data/home.json';
---
<Base title="Mockup — Sobre Nós" description="Conheça a AM Santos: 20 anos de experiência no mercado imobiliário, sob a liderança de António M Santos, com foco na qualidade, no conforto e na sustentabilidade.">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:100vh">
    <div
      class={sobre.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={sobre.hero.imagem ? `background-image:url(${sobre.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <TitleSplit text={sobre.hero.title} tag="h1" class="hero__title-page title-split--hero" />
      </div>
    </div>
  </section>

  <!-- QUEM SOMOS -->
  <section class="section">
    <div class="container has-wm">
      <div class="split split--reverse">
        <Frame>
          <div class="split__media reveal-wipe-lr"><div class="ph" data-label="Imagem 4:5"></div></div>
        </Frame>
        <div class="split__body">
          <TitleSplit text={sobre.quemSomos.title} />
          <p class="lead" style="margin:1rem 0 1.4rem">{sobre.quemSomos.lead}</p>
          <Divider />
          <p>{sobre.quemSomos.paragrafo}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- O QUE FAZEMOS — grelha de imagens em cascata + parágrafo.
       Sem costura nas fronteiras: esta secção entra e sai a direito. -->
  <section class="section section--dark">
    <div class="container has-wm">
      <Watermark variant="dark" side="r" size="md" y="top" />
      <div class="split comotrabalhamos">
        <div class="comotrabalhamos__grid">
          <div class="comotrabalhamos__col comotrabalhamos__col--a">
            {[...sobre.oQueFazemos.imagens.colunaA, ...sobre.oQueFazemos.imagens.colunaA].map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
          <div class="comotrabalhamos__col comotrabalhamos__col--b">
            {[...sobre.oQueFazemos.imagens.colunaB, ...sobre.oQueFazemos.imagens.colunaB].map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
        </div>
        <div class="split__body">
          <TitleSplit text={sobre.oQueFazemos.title} />
          <Stats items={home.oQueFazemos.stats} class="stats--compact" />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="section">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="md" y="top" />
      <TitleSplit text={sobre.servicos.title} style="margin-bottom:clamp(20px,2.5vw,32px)" />
      {sobre.servicos.items.map((s) => (
        <div class="service">
          <div class="service__media"><div class="ph" data-label="Imagem 5:4"></div></div>
          <div class="service__body">
            <h3>{s.title}</h3>
            <p>{s.texto}</p>
            {s.botao && <a class="btn" href="#">{s.botao}</a>}
            <Divider style="margin-bottom:clamp(40px,5vw,72px)" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- COSTURA · Serviços (branco) → Equipa (cinza) -->
  <Stitch variant="light" />

  <!-- EQUIPA -->
  <section class="section section--dark">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="md" y="top" />
      <TitleSplit text={sobre.equipa.title} />
      <Team members={sobre.equipa.members} />
    </div>
  </section>

  <!-- COSTURA · Equipa (cinza) → Contacto (branco) -->
  <Stitch variant="dark" />

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" y="bottom" />
      <ContactForm title={sobre.contacto.title} texto={sobre.contacto.texto} />
    </div>
  </section>
</Base>
