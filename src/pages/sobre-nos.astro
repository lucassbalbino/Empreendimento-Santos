---
import Base from '../layouts/Base.astro';
import Team from '../components/Team.astro';
import ContactForm from '../components/ContactForm.astro';
import Stitch from '../components/Stitch.astro';
import Watermark from '../components/Watermark.astro';
import sobre from '../data/sobre.json';

const fazemosTitle = sobre.oQueFazemos.title.replace(/\n/g, '<br>');
---
<Base title="Mockup — Sobre Nós" description="Conheça a AM Santos: 20 anos de experiência no mercado imobiliário, sob a liderança de António M Santos, com foco na qualidade, no conforto e na sustentabilidade.">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:100vh">
    <div
      class={sobre.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={sobre.hero.imagem ? `background-image:url(${sobre.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <Watermark variant="dark" side="r" size="lg" />
      <div class="container">
        <span class="eyebrow" style="color:#d29a5a">{sobre.hero.eyebrow}</span>
        <h1 class="display hero__title-page">{sobre.hero.title}</h1>
      </div>
    </div>
  </section>

  <!-- QUEM SOMOS -->
  <section class="section">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" />
      <div class="split split--reverse">
        <div class="split__media reveal-wipe-lr"><div class="ph" data-label="Imagem 4:5"></div></div>
        <div class="split__body">
          <span class="eyebrow">{sobre.quemSomos.eyebrow}</span>
          <h2 class="display display--sm">{sobre.quemSomos.title}</h2>
          <p class="lead" style="margin:1rem 0 1.4rem">{sobre.quemSomos.lead}</p>
          <p>{sobre.quemSomos.paragrafo}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COSTURA · Quem Somos (branco) → O Que Fazemos (cinza) -->
  <Stitch variant="light" />

  <!-- O QUE FAZEMOS — VERTICAIS -->
  <section class="section section--alt">
    <div class="container has-wm">
      <Watermark variant="fill" side="r" size="md" />
      <span class="eyebrow">{sobre.oQueFazemos.eyebrow}</span>
      <h2 class="display display--sm" set:html={fazemosTitle}></h2>
      <div class="verticals">
        {sobre.oQueFazemos.verticais.map((v) => (
          <div class="vertical">
            <div class="vertical__n">{v.n}</div>
            <h3>{v.title}</h3>
            <p>{v.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COSTURA · O Que Fazemos (cinza) → Serviços (branco) -->
  <Stitch variant="alt" />

  <!-- SERVIÇOS -->
  <section class="section">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" />
      <span class="eyebrow">{sobre.servicos.eyebrow}</span>
      <h2 class="display display--sm" style="margin-bottom:clamp(40px,5vw,72px)">{sobre.servicos.title}</h2>
      {sobre.servicos.items.map((s) => (
        <div class="service">
          <div class="service__media"><div class="ph" data-label="Imagem 5:4"></div></div>
          <div class="service__body">
            <h3>{s.title}</h3>
            <p>{s.texto}</p>
            {s.botao && <a class="btn" href="#">{s.botao}</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- COSTURA · Serviços (branco) → Equipa (cinza) -->
  <Stitch variant="light" />

  <!-- EQUIPA -->
  <section class="section section--alt">
    <div class="container has-wm">
      <Watermark variant="fill" side="r" size="md" />
      <span class="eyebrow">{sobre.equipa.eyebrow}</span>
      <h2 class="display display--sm">{sobre.equipa.title}</h2>
      <Team members={sobre.equipa.members} />
    </div>
  </section>

  <!-- COSTURA · Equipa (cinza) → Contacto (branco) -->
  <Stitch variant="alt" />

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="sm" />
      <ContactForm eyebrow={sobre.contacto.eyebrow} title={sobre.contacto.title} texto={sobre.contacto.texto} />
    </div>
  </section>
</Base>
