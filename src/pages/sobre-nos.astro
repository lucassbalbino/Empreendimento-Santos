---
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import Seam from '../components/Seam.astro';
import ContactForm from '../components/ContactForm.astro';
import Divider from '../components/Divider.astro';
import Frame from '../components/Frame.astro';
import Watermark from '../components/Watermark.astro';
import Blob from '../components/Blob.astro';
import TitleSplit from '../components/TitleSplit.astro';
import Stats from '../components/Stats.astro';
import sobre from '../data/sobre.json';
import home from '../data/home.json';

// Equipa como carrossel: cada card é um membro (foto | nome | cargo | bio).
const equipaCards = home.equipa.members.map((m) => ({
  quote: m.bio,
  name: m.name,
  designation: m.role,
  src: m.foto || '',
}));
---
<Base tipoPagina="AboutPage">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:100vh">
    <div
      class={sobre.hero.imagem ? 'hero__bg hero__bg--img' : 'hero__bg'}
      style={sobre.hero.imagem ? `background-image:url(${sobre.hero.imagem})` : undefined}
    ></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <TitleSplit text={sobre.hero.title} tag="h1" class="hero__title-page title-split--hero" data-i18n="sobre.hero.title" data-i18n-split="1" />
      </div>
    </div>
  </section>

  <!-- QUEM SOMOS -->
  <section class="section">
    <div class="container has-wm">
      <div class="split split--reverse split--text-wide">
        <Frame>
          <div class="split__media reveal-wipe-lr">
            {sobre.quemSomos.imagem
              ? <img class="split__img" src={sobre.quemSomos.imagem} alt={sobre.quemSomos.title} loading="lazy" />
              : <div class="ph" data-label="Imagem 4:5"></div>}
          </div>
        </Frame>
        <div class="split__body">
          <TitleSplit text={sobre.quemSomos.title} class="title-split--fit" data-i18n="sobre.quemSomos.title" data-i18n-split="1" />
          <p class="lead" style="margin:1rem 0 1.4rem" data-i18n="sobre.quemSomos.lead">{sobre.quemSomos.lead}</p>
          <Divider />
          <p data-i18n="sobre.quemSomos.paragrafo">{sobre.quemSomos.paragrafo}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- O QUE FAZEMOS — grelha de imagens em cascata + parágrafo.
       Sem costura nas fronteiras: esta secção entra e sai a direito. -->
  <section class="section section--dark has-blob">
    <Blob />
    <div class="container">
      <div class="split comotrabalhamos">
        <div class="comotrabalhamos__grid">
          <div class="comotrabalhamos__col comotrabalhamos__col--a">
            {[...sobre.oQueFazemos.imagens.colunaA, ...sobre.oQueFazemos.imagens.colunaA].map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
          <div class="comotrabalhamos__col comotrabalhamos__col--b">
            {[...sobre.oQueFazemos.imagens.colunaB, ...sobre.oQueFazemos.imagens.colunaB].map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
        </div>
        <div class="split__body">
          <TitleSplit text={sobre.oQueFazemos.title} data-i18n="sobre.oQueFazemos.title" data-i18n-split="1" />
          <Stats items={home.oQueFazemos.stats} class="stats--compact" i18nBase="home.oQueFazemos.stats" />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="section">
    <div class="container has-wm">
      <Watermark variant="line" side="r" size="md" y="top" />
      <TitleSplit text={sobre.servicos.title} style="margin-bottom:clamp(20px,2.5vw,32px)" data-i18n="sobre.servicos.title" data-i18n-split="1" />
      {sobre.servicos.items.map((s, i) => (
        <div class="service">
          <div class="service__media">
            {s.imagem
              ? <img class="service__img" src={s.imagem} alt={s.title} loading="lazy" />
              : <div class="ph" data-label="Imagem 5:4"></div>}
          </div>
          <div class="service__body">
            <h3 data-i18n={`sobre.servicos.items.${i}.title`}>{s.title}</h3>
            <p data-i18n={`sobre.servicos.items.${i}.texto`}>{s.texto}</p>
            {s.botao && <a class="btn" href="#" data-i18n={`sobre.servicos.items.${i}.botao`}>{s.botao}</a>}
            <Divider style="margin-bottom:clamp(40px,5vw,72px)" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- EQUIPA (carrossel: cada card é um membro). Bloco escuro em café, no
       mesmo padrão das outras .section--dark do site: a .seam abre a secção
       na variante escura (fronteira reta com os Serviços atrás, e é ela que
       dá o respiro do topo — por isso .section--seam-top) e o <Blob> põe a
       textura a sangrar pelos dois cantos opostos. Aqui vive sozinha, não
       numa .dark-run: as secções vizinhas são claras, logo não há junta
       interna a esconder e o <Blob> pode ficar dentro da própria secção.
       Saiu o .section--tight-bottom: o padding de baixo deixou de ser só
       espaço e passou a ser onde o bloco de cor acaba — no valor curto as
       setas do carrossel ficavam coladas à fronteira com o Contacto. -->
  <section class="section section--dark section--seam-top has-blob">
    <Blob />
    <Seam label="A Nossa Equipa" variant="dark" loose i18n="common.seam.aNossaEquipa" />
    <div class="container">
      <!-- Cores invertidas para o fundo escuro, nos mesmos tons que o resto
           das secções escuras usa: corpo a --paper (como .section--dark
           .member__bio) e o rótulo de cargo em bronze claro (como
           .section--dark .member__role) — o --accent-text da versão clara
           dava 2.4:1 aqui. As setas trocam de sentido: disco claro com o
           glifo escuro, o inverso do que faziam sobre a areia. -->
      <Testimonials
        testimonials={equipaCards}
        i18nBase="home.equipa.members"
        autoplay={true}
        colors={{
          name: 'var(--paper)',
          designation: 'var(--accent-dk)',
          testimony: 'var(--paper)',
          arrowBackground: 'var(--paper)',
          arrowForeground: 'var(--dark-soft)',
          arrowHoverBackground: 'var(--accent-dk)',
        }}
        fontSizes={{ name: '1.9rem', designation: '0.8rem', quote: '1.2rem' }}
      />
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">
      <Watermark variant="line" side="l" size="md" y="bottom" />
      <ContactForm title={sobre.contacto.title} texto={sobre.contacto.texto} titleI18n="sobre.contacto.title" textoI18n="sobre.contacto.texto" />
    </div>
  </section>
</Base>
