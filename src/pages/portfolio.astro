---
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import ContactForm from '../components/ContactForm.astro';
import portfolio from '../data/portfolio.json';
import { slugify } from '../utils/slug.js';

const secoes = [portfolio.emDesenvolvimento, portfolio.futuros];
---
<Base title="Mockup — Portfólio" description="Empreendimentos AMS Santos em desenvolvimento e projetos futuros — habitação e serviços na Grande Lisboa.">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:80vh">
    <div class="hero__bg"></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <span class="eyebrow" style="color:#d29a5a">{portfolio.hero.eyebrow}</span>
        <h1 class="display hero__title-page">{portfolio.hero.title}</h1>
      </div>
    </div>
  </section>

  <!-- PROJETOS: EM DESENVOLVIMENTO + FUTUROS -->
  {secoes.map((s, i) => (
    <section class={i === 1 ? "section section--alt" : "section"}>
      <div class="container">
        <BlockHead eyebrow={s.eyebrow} title={s.title} lead={s.lead} />
        <div class="grid-projects">
          {s.projetos.map((p) => (
            <a class="card" href={`/empreendimentos/${slugify(p.nome)}`}>
              <div class="card__media">
                <div class="ph"></div>
                <div class="card__overlay">
                  <h3 class="card__title">{p.nome}</h3>
                  <div class="card__meta">{p.localizacao} · {p.tipologia}</div>
                  {p.cta && <span class="card__cta">{p.cta}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container">
      <ContactForm eyebrow={portfolio.contacto.eyebrow} title={portfolio.contacto.title} texto={portfolio.contacto.texto} />
    </div>
  </section>
</Base>
