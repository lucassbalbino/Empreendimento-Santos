---
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import portfolio from '../data/portfolio.json';
import { porGrupo } from '../utils/projetos.js';

const secoes = [
  { ...portfolio.emDesenvolvimento, projetos: porGrupo('desenvolvimento') },
  { ...portfolio.futuros, projetos: porGrupo('futuro') },
];
---
<Base title="Mockup — Portfólio" description="Empreendimentos AM Santos em desenvolvimento e projetos futuros — vários projetos em pipeline, na vanguarda da inovação arquitetónica.">
  <!-- HERO (interno) -->
  <section class="hero" style="min-height:80vh">
    <div class="hero__bg"></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner">
      <div class="container">
        <span class="eyebrow" style="color:var(--accent-dk)">{portfolio.hero.eyebrow}</span>
        <h1 class="display hero__title-page">{portfolio.hero.title}</h1>
      </div>
    </div>
  </section>

  <!-- PROJETOS: EM DESENVOLVIMENTO + FUTUROS -->
  {secoes.map((s, i) => (
    <section class={i === 1 ? "section section--alt" : "section"}>
      <div class="container">
        <BlockHead eyebrow={s.eyebrow} title={s.title} lead={s.lead} />
        <div class="grid-projects">
          {s.projetos.map((p) => (<ProjectCard proj={p} />))}
        </div>
      </div>
    </section>
  ))}

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container">
      <ContactForm eyebrow={portfolio.contacto.eyebrow} title={portfolio.contacto.title} texto={portfolio.contacto.texto} />
    </div>
  </section>
</Base>
