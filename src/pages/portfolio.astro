---
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Stitch from '../components/Stitch.astro';
import Watermark from '../components/Watermark.astro';
import portfolio from '../data/portfolio.json';
import { porGrupo } from '../utils/projetos.js';

const secoes = [
  { ...portfolio.emDesenvolvimento, projetos: porGrupo('desenvolvimento') },
  { ...portfolio.futuros, projetos: porGrupo('futuro') },
];
---
<Base flat title="Mockup — Portfólio" description="Empreendimentos AM Santos em desenvolvimento e projetos futuros — vários projetos em pipeline, na vanguarda da inovação arquitetónica.">
  <!-- PROJETOS: EM DESENVOLVIMENTO + FUTUROS. Sem hero — a página abre direto
       nos cards. Costura na fronteira de cor entre o 1.º bloco (branco) e o
       2.º (cinza). -->
  {secoes.map((s, i) => (
    <>
      {i === 1 && <Stitch variant="light" />}
      <section class={`section section--centered-head ${i === 1 ? "section--alt" : "section--flat-top"}`}>
        <div class="container has-wm">
          <Watermark variant="fill" side={i === 0 ? "l" : "l"} size="lg" y="top" />
          <BlockHead eyebrow={s.eyebrow} title={s.title} lead={s.lead} as={i === 0 ? 'h1' : 'h2'} />
          <div class="grid-projects">
            {s.projetos.map((p) => (
              <div class="card-rise"><ProjectCard proj={p} /></div>
            ))}
          </div>
        </div>
      </section>
    </>
  ))}

  <!-- COSTURA · Futuros (cinza) → Contacto (branco) -->
  <Stitch variant="alt" />

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container has-wm">

      <ContactForm eyebrow={portfolio.contacto.eyebrow} title={portfolio.contacto.title} texto={portfolio.contacto.texto} />
    </div>
  </section>

  <script is:inline>
    // Reveal PRÓPRIO dos cards do portfólio. Dois caminhos distintos:
    //
    //  1.º BLOCO (.section--flat-top, acima da dobra): faz o SLIDE PESADO de
    //     entrada (título + cards) e SÓ dispara depois de um frame inicial
    //     garantidamente pintado. É isto que corrige a navbar: o card está em
    //     vista no instante da navegação, por isso o callback do observer chega
    //     cedo demais (antes do estado inicial pintar) e a subida saltava — só
    //     o refresh animava, porque aí o parse→paint garante o frame de partida.
    //     Gate: espera a cortina levantar (__amsCurtainBusy volta a false) na
    //     navegação por cortina; double-rAF na carga direta. Aí o estado inicial
    //     já pintou → o slide anima sempre, incl. via navbar.
    //
    //  RESTANTES .card-rise (2.º bloco, "Futuros"): reveal por SCROLL via
    //     observer, disparado ~15% ANTES de entrar (rootMargin positivo). Aqui o
    //     card foi pintado em repouso muito antes de entrar em vista, por isso o
    //     callback assíncrono já cai depois do paint — sem salto.
    //
    // Init UMA vez (o script re-corre em cada nav para o portfólio); o listener
    // astro:page-load persiste e chama setup em cada nav, como o Base.astro.
    (function () {
      if (window.__amsPortfolioRise) return;
      window.__amsPortfolioRise = true;
      var root = document.documentElement;

      var earlyIO = ('IntersectionObserver' in window)
        ? new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-risen'); earlyIO.unobserve(e.target); }
            });
          }, { threshold: 0, rootMargin: '0px 0px 15% 0px' })
        : null;

      // Reabrir a moldura no fim da subida (transform) para a sombra do hover
      // não ser cortada pelo overflow:hidden. once: a subida é única.
      function bindOpen(w, card) {
        card.addEventListener('transitionend', function onRise(e) {
          if (e.propertyName !== 'transform') return;
          w.classList.add('is-open');
          card.removeEventListener('transitionend', onRise);
        });
      }

      // Dispara o slide pesado do 1.º bloco: título (.is-entered na secção) +
      // cards (.is-risen).
      // FORÇA UM REFLOW antes de adicionar as classes: é isto que faz a subida
      // animar em vez de saltar. Em soft-nav / View Transition, o DOM é inserido
      // e as classes seriam adicionadas no MESMO tick — o browser resolveria
      // início e fim juntos e a transição não teria ponto de partida (salto
      // seco, "apenas o fade"). Ler offsetHeight obriga o browser a comprometer
      // já o estado ESCONDIDO (translateY(80px)/100%) como baseline; a seguir a
      // troca de classe interpola a partir daí. (Mais fiável do que esperar rAF.)
      function enterFirstBlock(first) {
        void first.offsetHeight; // reflow: compromete o estado escondido
        first.classList.add('is-entered');
        first.querySelectorAll('.card-rise').forEach(function (w) {
          var card = w.querySelector('.card');
          if (card) bindOpen(w, card);
          w.classList.add('is-risen');
        });
      }

      // Espera um frame inicial garantidamente pintado antes de disparar:
      //  - cortina em curso (navbar): poll até __amsCurtainBusy voltar a false
      //    (fade terminado = já passaram vários frames desde o swap);
      //  - carga direta / soft-nav sem cortina: double-rAF (garante 1 paint do
      //    estado inicial entre os dois rAF).
      function whenPainted(cb) {
        if (window.__amsCurtainBusy) {
          var id = setInterval(function () {
            if (!window.__amsCurtainBusy) { clearInterval(id); cb(); }
          }, 50);
        } else {
          requestAnimationFrame(function () { requestAnimationFrame(cb); });
        }
      }

      function setup() {
        var reveal = earlyIO && root.classList.contains('reveal-ready');

        // 1.º bloco: entrada dedicada e gated. enterBound marcado já (síncrono)
        // para o 2.º setup() da mesma nav não re-agendar.
        var first = document.querySelector('.section--flat-top');
        if (first && !first.dataset.enterBound) {
          first.dataset.enterBound = '1';
          if (!reveal) {
            // Sem reveal-ready (reduced-motion / sem IO): entra já assente.
            first.classList.add('is-entered');
            first.querySelectorAll('.card-rise').forEach(function (w) {
              w.classList.add('is-risen', 'is-open');
            });
          } else {
            whenPainted(function () { enterFirstBlock(first); });
          }
        }

        // Restantes .card-rise (2.º bloco): reveal por scroll via observer.
        document.querySelectorAll('.card-rise').forEach(function (w) {
          if (w.dataset.riseBound) return;
          if (w.closest('.section--flat-top')) return; // 1.º bloco tratado acima
          w.dataset.riseBound = '1';
          var card = w.querySelector('.card');
          if (!card) return;
          if (!reveal) { w.classList.add('is-risen', 'is-open'); return; }
          earlyIO.observe(w);
          bindOpen(w, card);
        });
      }

      document.addEventListener('astro:page-load', setup);
      // Também já: se o astro:page-load desta navegação já disparou antes deste
      // script correr, o listener acima não o apanharia.
      setup();
    })();
  </script>
</Base>
