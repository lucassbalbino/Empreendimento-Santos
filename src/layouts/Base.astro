---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {
  title,
  description = 'AMS Santos — promoção imobiliária e construção civil em Lisboa. Concebemos, construímos e entregamos empreendimentos feitos para durar.',
  image = '/images/hero-image.webp',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
---
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>

  <!-- Favicon (marca AMS Santos) -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#141414">

  <!-- Open Graph / partilha em redes sociais -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AMS Santos">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">

  <!-- Revelar-ao-rolar: marca reveal-ready antes do paint (sem flash).
       Inativo se o utilizador prefere menos movimento ou sem IntersectionObserver. -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (!('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('reveal-ready');
      var SEL = '.section, .section .eyebrow, .section .display, .section .lead, .split__body > p, .card, .stat, .vertical, .service, .member, .panels';
      function init() {
        var els = Array.prototype.slice.call(document.querySelectorAll(SEL));
        els.forEach(function (el) {
          var sibs = el.parentNode ? el.parentNode.children : [el];
          var i = Array.prototype.indexOf.call(sibs, el);
          el.style.transitionDelay = (Math.min(i, 6) * 70) + 'ms';
        });
        function reveal(el) { el.classList.add('is-visible'); }
        // Gatilho principal: IntersectionObserver (revela ao entrar).
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        els.forEach(function (el) { io.observe(el); });
        // Fail-safe: revela o que está no viewport mesmo que o IO esteja
        // suspenso (aba em 2.º plano ao carregar, bfcache, throttling).
        // Garante que o conteúdo nunca fica preso escondido/coberto.
        function revealInView() {
          var vh = window.innerHeight || root.clientHeight;
          for (var j = 0; j < els.length; j++) {
            var el = els[j];
            if (el.classList.contains('is-visible')) continue;
            var r = el.getBoundingClientRect();
            if (r.top < vh * 0.92 && r.bottom > 0) { reveal(el); io.unobserve(el); }
          }
        }
        // Throttle por tempo (não rAF, que é suspenso em abas ocultas).
        var last = 0;
        function onScroll() {
          var now = Date.now();
          if (now - last < 100) return;
          last = now;
          revealInView();
        }
        revealInView();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        window.addEventListener('pageshow', revealInView);
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) revealInView();
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>
</head>
<body class={isHome ? 'is-home' : undefined}>
  <Header />
  <slot />
  <Footer />
  <script is:inline src="/main.js"></script>
  <!-- Cloudflare Web Analytics — substituir TOKEN ao publicar -->
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon='{"token": "TOKEN_DO_CLOUDFLARE"}'></script>
</body>
</html>
