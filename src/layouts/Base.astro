---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageCurtain from '../components/PageCurtain.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Seo from '../components/Seo.astro';
import seoConfig from '../data/seo.json';
const {
  flat = false,
  /* Tudo o que segue é SEO e vai direto para o <Seo>. As páginas estáticas não
     precisam de passar nada — o Seo.astro resolve pelo caminho contra o
     src/data/seo.json. Só as rotas dinâmicas (empreendimentos, blog) passam
     título e descrição calculados. */
  title,
  description,
  image,
  noindex,
  tipoPagina,
  schemaExtra,
  trilhoItens,
  preloadImagem,
} = Astro.props;
const isHome = Astro.url.pathname === '/';
// A prop `palette` saiu daqui: servia o andaime de teste da recoloração
// (palette="test-b46511"), retirado na Task 1. Nenhuma página a passava, por
// isso a classe palette-* nunca chegou ao <body>.
const bodyClass = [isHome && 'is-home', flat && 'no-hero'].filter(Boolean).join(' ') || undefined;
---
<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <Seo
    title={title}
    description={description}
    imagem={image}
    noindex={noindex}
    tipoPagina={tipoPagina}
    schemaExtra={schemaExtra}
    trilhoItens={trilhoItens}
    preloadImagem={preloadImagem}
  />

  <!-- Favicon (marca AM Santos) -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#241a12">
  <!-- Site só claro: impede o modo escuro automático do browser de escurecer as
       cores quando o SO está em dark mode (sinal dado antes do CSS carregar). -->
  <meta name="color-scheme" content="only light">

  <!-- Open Graph, canonical, robots e JSON-LD vivem todos no <Seo> acima. -->
  <link rel="manifest" href="/site.webmanifest">
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">

  <!-- Fontes: servidas do PRÓPRIO domínio (@font-face no topo do styles.css,
       gerados por scripts/fontes-descarregar.mjs). O <link> para
       fonts.googleapis.com que aqui estava era render-blocking e obrigava a
       duas ligações novas — googleapis para o CSS, gstatic para os .woff2 —
       antes de a primeira letra poder aparecer. Medido com o Lighthouse neste
       site: 2,9 s de First Contentful Paint com ele, 1,1 s sem ele.

       O preload é dos subconjuntos LATINOS, os únicos que o site escreve na
       primeira dobra. `crossorigin` é obrigatório mesmo em same-origin: as
       fontes são sempre pedidas em modo anónimo e, sem o atributo, o browser
       descarrega o ficheiro duas vezes. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">

  <!-- Gate do preloader: liga is-loading ANTES do paint, só na 1.ª carga real
       (não em soft-nav nem com prefers-reduced-motion). Evita flash de conteúdo. -->
  <script is:inline>
    (function () {
      try {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = sessionStorage.getItem('ams-preloaded');
        if (!reduce && !seen) document.documentElement.classList.add('is-loading');
      } catch (e) {}
    })();
  </script>
  <ViewTransitions />

  <!-- Revelar-ao-rolar: marca reveal-ready antes do paint (sem flash).
       Inativo se o utilizador prefere menos movimento ou sem IntersectionObserver. -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (!('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('reveal-ready');
      // .seam entra aqui (e não a reboque da .section que a contém): a costura
      // vive no topo da secção e a secção só cruza o threshold de 0.12 muito
      // depois — numa secção alta, a régua já tinha passado pelo ecrã quando a
      // .is-visible do pai chegasse. Observada por si, desenha-se à entrada.
      var SEL = '.section, .seam, .card, .stat, .service, .member, .panels, .reveal-wipe-lr, .reveal-rise-slow';
      var els = [];

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

      // Fail-safe: revela o que está no viewport mesmo com o IO suspenso (aba em
      // 2.º plano, bfcache, throttling). Lê sempre a lista `els` atual.
      function revealInView() {
        var vh = window.innerHeight || root.clientHeight;
        for (var j = 0; j < els.length; j++) {
          var el = els[j];
          if (el.classList.contains('is-visible')) continue;
          var r = el.getBoundingClientRect();
          if (r.top < vh * 0.92 && r.bottom > 0) { el.classList.add('is-visible'); io.unobserve(el); }
        }
      }
      var last = 0;
      function onScroll() {
        var now = Date.now();
        if (now - last < 100) return;
        last = now;
        revealInView();
      }

      // Globais UMA só vez (o script inline corre só uma vez).
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      window.addEventListener('pageshow', revealInView);
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) revealInView();
      });

      // Por página: re-selecionar elementos novos, dar delay em cascata, observar.
      function setup() {
        els = Array.prototype.slice.call(document.querySelectorAll(SEL));
        els.forEach(function (el) {
          var sibs = el.parentNode ? el.parentNode.children : [el];
          var i = Array.prototype.indexOf.call(sibs, el);
          el.style.transitionDelay = (Math.min(i, 6) * 70) + 'ms';
          io.observe(el);
        });
        revealInView();
      }

      // `astro:page-load` dispara na 1.ª carga e em cada navegação suave.
      document.addEventListener('astro:page-load', setup);

      // Repor reveal-ready em cada soft-nav. O Astro, no swap da View Transition,
      // substitui os atributos do <html> pelos do documento novo (que não tem
      // reveal-ready), e este script inline — idêntico entre páginas — é
      // deduplicado, por isso NÃO volta a correr para a re-adicionar. Sem isto,
      // ao navegar pela navbar todas as regras `html.reveal-ready` deixam de
      // aplicar e os reveals/entradas saltam (aparecem já assentes). `after-swap`
      // corre depois do swap e ANTES do paint e do astro:page-load — repõe a
      // classe a tempo de o estado inicial pintar e a transição animar. (Estamos
      // já depois do guard de reduced-motion / IO, por isso só se repõe quando
      // o reveal está ativo.)
      document.addEventListener('astro:after-swap', function () {
        root.classList.add('reveal-ready');
      });
    })();
  </script>
</head>
<body class={bodyClass}>
  <div id="preloader" class="preloader" aria-hidden="true">
    <div class="preloader__bar"></div>
    <div class="preloader__count"><span class="preloader__num">0</span></div>
  </div>
  <Header />
  <slot />
  <Footer />
  <PageCurtain />
  <CookieBanner />
  <!-- Scroll interpolado (Lenis) + parallax da hero.

       O browser move a página aos degraus: cada volta de roda é um salto seco.
       O Lenis guarda um alvo virtual e aproxima a posição real desse alvo a
       cada frame, transformando o degrau num deslize que desacelera. É daqui
       que vem a fluidez — nenhuma transição CSS a consegue imitar, porque o
       que está a saltar é a própria posição do scroll.

       O parallax da hero corre DENTRO do evento do Lenis (e não num listener
       de scroll com rAF próprio) para a imagem e a página serem pintadas no
       mesmo frame; caso contrário a imagem fica um frame atrás e tremelica.

       Tudo isto é progressivo: sem JS, com prefers-reduced-motion, ou em
       ecrã tátil, fica o scroll nativo e --hero-parallax a 0. O toque não
       tem a mesma física do rato: o dedo já impõe o próprio momentum ao
       scroll nativo do browser, e o Lenis por cima disso (a reamostrar via
       rAF a cada frame) competia pelo mesmo thread principal e engasgava —
       sobretudo em telemóveis mais fracos. -->
  <script>
    import Lenis from 'lenis';

    const DRIFT = 0.15;  // fração do scroll que a imagem da hero percorre
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      window.matchMedia('(pointer: coarse)').matches;

    // Scripts de módulo só correm UMA vez com ViewTransitions. Por isso o Lenis
    // é reconstruído a cada `astro:page-load` (dispara na 1.ª carga e em cada
    // navegação suave), destruindo a instância anterior — senão a partir da 2.ª
    // página o scroll fica seco e o parallax da hero congela.
    let lenis = null;
    let loopIniciado = false;
    let pin = null;             // encaixe dos Serviços a decorrer (ver mais abaixo), ou null
    let suprimirReencaixe = false;  // ver o largar em sentido inverso, dentro de avancarPin
    let largarPinInput = null;  // remove os listeners de wheel/touch do pin da página anterior

    function iniciarLenis() {
      if (lenis) { lenis.destroy(); lenis = null; }
      if (largarPinInput) { largarPinInput(); largarPinInput = null; }
      pin = null;

      const bg = document.querySelector('.hero__bg--img');
      const hero = bg?.closest('.hero');
      const moverHero = (y) => {
        if (!hero || y > hero.offsetHeight) return;
        bg.style.setProperty('--hero-parallax', y * (1 - DRIFT) + 'px');
      };

      if (quieto) {
        document.documentElement.classList.add('sem-lenis');
        window.__amsLenis = undefined;
        return;
      }
      document.documentElement.classList.remove('sem-lenis');

      // Parallax da imagem "Quem Somos" (home): o mesmo movimento ancorado da
      // hero, mas a meio da página — a deriva depende da distância do centro da
      // moldura ao centro do ecrã. Corre no evento do Lenis (como a hero) para
      // ficar colada ao scroll fluido. Clampada à folga do scale(1.45) da
      // imagem para nunca abrir vazios (a folga muda com o rácio ecrã/imagem,
      // sobretudo em telemóvel, onde a moldura fica baixa).
      const QS_FACTOR = 0.16;   // fração da distância-ao-centro que a imagem deriva
      const QS_SCALE = 1.45;    // = scale de .quemsomos__img em styles.css
      const qsImg = document.querySelector('.quemsomos__img');
      const qsMedia = qsImg?.closest('.quemsomos__media');
      const moverQuem = () => {
        if (!qsImg || !qsMedia) return;
        const r = qsMedia.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) return;   // fora de vista
        const dist = (r.top + r.height / 2) - window.innerHeight / 2;
        const folga = r.height * (QS_SCALE - 1) / 2;              // px disponíveis de cada lado
        let off = -dist * QS_FACTOR;
        if (off > folga) off = folga; else if (off < -folga) off = -folga;
        qsImg.style.setProperty('--qs-parallax', off.toFixed(1) + 'px');
      };

      // Encaixe da imagem e do texto nos Serviços ("O que nos move", Sobre
      // Nós): ponto de partida — a imagem ocupa a linha toda (as duas
      // colunas do grid + o gap) e o corpo (título+texto) está bem mais
      // longe do que a sua posição final e invisível, deslocado para o
      // canto oposto ao seu próprio lado (--fit-tx) — desliza e esbate ao
      // mesmo tempo. A imagem fica assim, GRANDE E PARADA, enquanto
      // sobe pelo ecrã. No instante em que o CENTRO do bloco cruza o centro
      // do ecrã (a imagem já toda à vista, a meio caminho de sair), a
      // página PRENDE — lenis.stop(), que já trava scroll nativo, roda e
      // teclado (a .lenis-stopped{overflow:clip} é do próprio pacote) — e
      // passa a ler o wheel/touch diretamente para avançar o gesto a passo
      // do dedo/roda, não do relógio: a imagem encolhe para a sua coluna e
      // o corpo desliza do canto até ao lugar, os dois em sincronia (mesmo
      // `p`). Só liberta o scroll quando chegam à posição final (ou volta
      // ao ponto de partida, se o gesto inverter a meio). Aplica-se um
      // bloco de cada vez: começar um segundo enquanto o primeiro ainda
      // prende não pode acontecer, porque presos os únicos eventos que
      // mexem alguma coisa são os do próprio pin. Nula em ecrãs ≤760px: aí
      // o grid empilha numa só coluna (ver styles.css) e a imagem já nasce
      // à largura da linha.
      const servicos = document.querySelectorAll('.service');
      const TEXT_OFFSET = 320;   // px de onde o corpo (título+texto) arranca, bem mais longe da posição final, no canto oposto à imagem
      const MEDIA_RATIO = 1.3;   // altura da imagem = largura natural × isto (1.3 = mais alta que larga; era 1 = quadrada, antes 0.8 = 5:4)
      // Fração da altura da imagem que ela desce/sobe — dá o encurtamento
      // diagonal, não só lateral. Moderada de propósito: como o deslocamento
      // vale 0 (o mesmo de progresso=0) desde que o bloco entra em vista —
      // não só durante o pin — um valor alto aproximava visivelmente os dois
      // blocos um do outro enquanto o segundo ainda esperava a vez, antes
      // de sequer prender.
      const MEDIA_TY_FACTOR = 0.08;
      // Prende quando o CENTRO do bloco cruza o centro do ecrã — não quando o
      // topo está prestes a sair (isso era cedo demais: a imagem ainda mal
      // tinha entrado). vh recalculado a cada chamada (não guardado) porque
      // isto corre tanto no tick de scroll como no wheel do pin, em alturas
      // de janela que podem ter mudado entretanto (raro, mas barato de tratar).
      const centroNoMeio = (r) => (r.top + r.height / 2) <= window.innerHeight / 2;

      function aplicarEncaixe(media, body, natural, rowWidth, p, reversed) {
        const scaleFull = natural > 0 ? rowWidth / natural : 1;
        const mediaH = natural * MEDIA_RATIO;
        media.style.setProperty('--fit-scale', (scaleFull + (1 - scaleFull) * p).toFixed(4));
        media.style.setProperty('--media-h', mediaH.toFixed(2) + 'px');   // preso — não acompanha a largura
        // O encurtamento não é só lateral: a imagem também sobe/desce
        // (--fit-ty) enquanto a largura encolhe, para o percurso ler-se
        // quase diagonal em vez de um achatamento reto. Cada lado desce ou
        // sobe em sentido oposto (como o corpo), para os dois blocos não
        // repetirem exatamente o mesmo movimento.
        const ty = (1 - p) * mediaH * MEDIA_TY_FACTOR * (reversed ? -1 : 1);
        media.style.setProperty('--fit-ty', ty.toFixed(1) + 'px');
        // O corpo entra do canto oposto ao que a imagem ocupa (a imagem cresce
        // a partir do seu próprio lado, o corpo desliza a partir do outro) —
        // os dois chegam à posição lado a lado no mesmo instante, p=1,
        // esbatendo enquanto desliza (não de repente ao chegar).
        const tx = (1 - p) * TEXT_OFFSET * (reversed ? -1 : 1);
        body.style.setProperty('--fit-tx', tx.toFixed(1) + 'px');
        body.style.setProperty('--fit-opacity', p.toFixed(3));
      }

      function largarPin() {
        pin = null;
        lenis?.start();
      }

      // Só corre com o scroll a render (nunca durante o pin: aí quem manda
      // é o wheel/touch abaixo) — como os outros parallaxes desta função.
      // `pinDone` marca no próprio elemento (dataset, sobrevive a este
      // fecho) que ESTE bloco já encaixou: sem isso, mal o pin larga a
      // meio (ainda com o centro no meio do ecrã), o tick de scroll seguinte
      // via Lenis lia outra vez a mesma posição e voltava a prender do zero
      // — um ciclo sem fim. Só se apaga quando o bloco desce de novo abaixo
      // do ecrã (r.top>vh), para poder reentrar "grande e parado" da
      // próxima vez, e nunca enquanto está à vista (evitaria um salto
      // visível).
      const moverServicos = () => {
        if (!servicos.length || window.innerWidth <= 760 || pin) return;
        const vh = window.innerHeight;
        servicos.forEach((el) => {
          const media = el.querySelector('.service__media');
          const body = el.querySelector('.service__body');
          if (!media || !body) return;
          const r = el.getBoundingClientRect();
          if (r.bottom < 0) return;   // acima da vista — mantém o que já lá estava
          if (r.top > vh) { el.dataset.pinDone = ''; return; }   // ainda por vir — pronto para reentrar
          const reversed = el.matches(':nth-child(even)');   // imagem à direita, corpo à esquerda
          const gap = parseFloat(getComputedStyle(el).columnGap) || 0;
          const natural = (r.width - gap) / 2;
          if (el.dataset.pinDone === '1') { aplicarEncaixe(media, body, natural, r.width, 1, reversed); return; }
          if (centroNoMeio(r)) {
            if (suprimirReencaixe) return;   // ver o largar em sentido inverso, dentro de avancarPin
            // Instante exato em que o centro do bloco cruza o centro do
            // ecrã: prende aqui, a meio (progresso 0), sem saltar — o resto
            // do encolher passa a vir do gesto, não do scroll (que está
            // travado).
            pin = { el, media, body, natural, rowWidth: r.width, reversed, runway: r.height * 1.1, progress: 0 };
            lenis?.stop();
            aplicarEncaixe(media, body, natural, r.width, 0, reversed);
            return;
          }
          aplicarEncaixe(media, body, natural, r.width, 0, reversed);   // ainda a descer: grande e parada
        });
      };

      // Wheel/touch só fazem alguma coisa enquanto `pin` existe — nos
      // restantes momentos o scroll é todo do Lenis, como seria sem isto.
      function onWheelPin(e) {
        if (!pin) return;
        e.preventDefault();
        e.stopPropagation();
        avancarPin(e.deltaY);
      }
      let touchY = 0;
      function onTouchStartPin(e) {
        if (!pin) return;
        touchY = e.touches[0].clientY;
      }
      function onTouchMovePin(e) {
        if (!pin) return;
        e.preventDefault();
        e.stopPropagation();
        const y = e.touches[0].clientY;
        avancarPin(touchY - y);
        touchY = y;
      }
      function avancarPin(delta) {
        const antes = pin.progress;
        const seguinte = antes + delta / pin.runway;
        if (seguinte >= 1) {
          aplicarEncaixe(pin.media, pin.body, pin.natural, pin.rowWidth, 1, pin.reversed);
          pin.el.dataset.pinDone = '1';
          largarPin();
        } else if (seguinte <= 0 && antes <= 0 && delta < 0) {
          aplicarEncaixe(pin.media, pin.body, pin.natural, pin.rowWidth, 0, pin.reversed);
          const el = pin.el;
          // `largarPin` chama lenis.start(), que dispara logo um scroll
          // síncrono — e nesse instante o r.top ainda é o mesmo <=0 de
          // quando se prendeu, por isso reengatava na hora. A bandeira
          // trava esse reengate só até o empurrão (abaixo) pôr o r.top
          // de novo positivo.
          suprimirReencaixe = true;
          largarPin();
          const r = el.getBoundingClientRect();
          if (centroNoMeio(r)) {
            const alvo = (window.innerHeight / 2 - r.height / 2) + 8;   // r.top uns 8px lá de fora do meio
            lenis?.scrollTo(window.scrollY - (alvo - r.top), { immediate: true });
          }
          suprimirReencaixe = false;
        } else {
          pin.progress = Math.min(1, Math.max(0, seguinte));
          aplicarEncaixe(pin.media, pin.body, pin.natural, pin.rowWidth, pin.progress, pin.reversed);
        }
      }
      window.addEventListener('wheel', onWheelPin, { passive: false, capture: true });
      window.addEventListener('touchstart', onTouchStartPin, { passive: true, capture: true });
      window.addEventListener('touchmove', onTouchMovePin, { passive: false, capture: true });
      largarPinInput = () => {
        window.removeEventListener('wheel', onWheelPin, { capture: true });
        window.removeEventListener('touchstart', onTouchStartPin, { capture: true });
        window.removeEventListener('touchmove', onTouchMovePin, { capture: true });
      };

      lenis = new Lenis({
        lerp: 0.1,
        wheelMultiplier: 1,
        touchMultiplier: 1.6,
        smoothWheel: true,
        syncTouch: false,
      });
      window.__amsLenis = lenis;

      // Se o preloader ou a cortina estão a decorrer, a nova instância nasce
      // parada; quem os controla chama start() quando termina.
      if (document.documentElement.classList.contains('is-loading') || window.__amsCurtainBusy) {
        lenis.stop();
      }

      lenis.on('scroll', ({ scroll }) => { moverHero(scroll); moverQuem(); moverServicos(); });

      // Loop rAF único e permanente; lê sempre a instância atual (module-scope).
      if (!loopIniciado) {
        const frame = (t) => { if (lenis) lenis.raf(t); requestAnimationFrame(frame); };
        requestAnimationFrame(frame);
        loopIniciado = true;
      }
      moverHero(window.scrollY);
      moverQuem();
      moverServicos();
    }

    document.addEventListener('astro:page-load', iniciarLenis);
  </script>
  <!-- Split-text por linha: parte o texto de secção e revela linha-a-linha. -->
  <script>
    import '../scripts/split-reveal.js';
  </script>
  <!-- Preloader: contador 0→100 (sobe até 99, window.load leva a 100, teto 2,5s)
       e saída por wipe para cima. Só corre se o gate ligou is-loading. -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (!root.classList.contains('is-loading')) return;  // não é 1.ª carga / reduced-motion
      var pre = document.getElementById('preloader');
      if (!pre) { root.classList.remove('is-loading'); return; }
      var bar = pre.querySelector('.preloader__bar');
      var num = pre.querySelector('.preloader__num');

      var shown = 0, target = 0, loaded = false, raf, ended = false;
      var t0 = Date.now();
      var RAMP = 2400;   // duração base do contador (ritmo dramático, indep. da velocidade de carga)

      function complete() { loaded = true; }   // deixa o contador passar dos 99 até 100

      function tick() {
        try {
          var elapsed = Date.now() - t0;
          var cap = loaded ? 100 : 99;                       // só passa dos 99 quando carregado
          target = Math.min(cap, (elapsed / RAMP) * 100);    // o ritmo é dado pelo RAMP
          shown += (target - shown) * 0.12;                  // easing suave até ao alvo
          var v = Math.min(100, Math.round(shown));
          if (num) num.textContent = v;
          if (bar) bar.style.transform = 'scaleX(' + (v / 100) + ')';
          if (target >= 100 && v >= 100) { finish(); return; }
          raf = requestAnimationFrame(tick);
        } catch (e) {
          finish();   // um erro no loop não pode deixar o preloader preso
        }
      }

      function finish() {
        if (ended) return; ended = true;
        cancelAnimationFrame(raf);
        pre.classList.add('preloader--out');               // wipe para cima (CSS transition)
        try { sessionStorage.setItem('ams-preloaded', '1'); } catch (e) {}
        setTimeout(function () {
          window.__amsLenis?.start();   // liberta o scroll ao sair o preloader
          root.classList.remove('is-loading');             // destrava o scroll
          pre.remove();
        }, 750);                                            // = duração da transição de saída
      }

      if (document.readyState === 'complete') complete();
      else window.addEventListener('load', complete);
      setTimeout(complete, 1250);                           // teto: nunca ficar preso
      setTimeout(finish, 3500);     // teto duro: força a saída mesmo se o loop parar (> RAMP + saída)
      raf = requestAnimationFrame(tick);
    })();
  </script>
  <script is:inline src="/main.js"></script>
  <!-- Núcleo do consentimento: lê/grava o cookie ams-consent, liga o aviso por
       delegação e é quem transforma os scripts inertes abaixo em scripts a
       sério. Depois do main.js porque reutiliza o mesmo padrão de
       astro:page-load e nada nele depende de correr antes. -->
  <script is:inline src="/consent.js"></script>
  <!-- Cloudflare Web Analytics. Só entra quando houver token a sério em
       src/data/seo.json > analytics.cloudflareToken: com o token de exemplo, o
       beacon falhava em TODAS as páginas (pedido perdido + erro de CORS na
       consola, que o Lighthouse conta contra as boas práticas) e não media
       coisa nenhuma.

       Entra INERTE: `type="text/plain"` não é executado por browser nenhum, e o
       endereço viaja em data-src justamente para o browser não o ir buscar por
       antecipação. Só depois de o visitante aceitar a categoria Estatísticas é
       que o /consent.js clona isto para um <script> verdadeiro, traduzindo os
       data-attr-* nos atributos reais (data-attr-defer → defer). Antes disso não
       há pedido nenhum à Cloudflare — que é o ponto: consentimento prévio. -->
  {seoConfig.analytics?.cloudflareToken && (
    <script
      is:inline
      type="text/plain"
      data-ams-consent="estatisticas"
      data-src="https://static.cloudflareinsights.com/beacon.min.js"
      data-attr-defer=""
      data-attr-data-cf-beacon={JSON.stringify({ token: seoConfig.analytics.cloudflareToken })}
    ></script>
  )}
</body>
</html>
