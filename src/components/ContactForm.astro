---
const { eyebrow, title, texto } = Astro.props;
---
<div class="contact">
  <div>
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="display display--sm">{title}</h2>
    <p class="muted" style="margin-top:1rem;max-width:40ch">{texto}</p>
  </div>
  <form class="contact__form" onsubmit="return false">
    <div class="field"><label>Nome</label><input type="text" placeholder="O seu nome"></div>
    <div class="field"><label>Email</label><input type="email" placeholder="o.seu.email@exemplo.pt"></div>
    <div class="field"><label>Assunto</label>
      <select><option>Selecione — Assunto</option><option>Empreendimentos</option><option>Investimento</option><option>Outro assunto</option></select>
    </div>
    <div class="field"><label>Mensagem</label><textarea placeholder="Escreva aqui a sua mensagem…"></textarea></div>
    <label class="check"><input type="checkbox"> Autorizo o tratamento dos meus dados para efeitos de contacto, nos termos da Política de Privacidade.</label>
    <button class="btn" type="submit">Enviar mensagem</button>
  </form>
</div>
