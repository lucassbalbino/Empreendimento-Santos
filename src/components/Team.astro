---
/* Índice da equipa em filetes, agrupado por departamento.

   A página deixou de ter retrato de cada pessoa, e é isso que define esta
   montagem: com apenas nome e função, uma grelha de cartões passa a ser uma
   grelha de buracos. A lista em filetes resolve o vazio — o traço é que dá
   ritmo à página — e o agrupamento por departamento é o que a impede de se
   ler como uma enumeração solta: são áreas de competência, não oito nomes.

   Duas formas de entrada, porque as duas secções da /equipa pedem coisas
   diferentes e não vale a pena inventar um departamento para a direção:

     members={[...]}   lista simples, sem cabeçalho de área (usa variant="lead")
     grupos={[...]}    [{ area, members }] — um bloco por departamento

   Ambas caem na mesma estrutura interna, por isso o CSS é um só. */
const { members, grupos, variant, i18nBase } = Astro.props;
const cls = variant ? `roster roster--${variant}` : 'roster';

/* Normaliza as duas entradas num só formato. Um grupo sem `area` é a lista
   simples: não ganha coluna de departamento (ver --titled no CSS). */
const blocos = grupos
  ? grupos.map((g, gi) => ({ area: g.area, members: g.members || [], gi }))
  : [{ area: null, members: members || [], gi: null }];

/* Chaves de i18n. A raiz muda com a forma da entrada, e o índice do grupo tem
   de entrar no caminho quando ele existe — senão duas pessoas na mesma posição
   de departamentos diferentes pediam a mesma chave e traduziam uma pela outra:

     members  →  <base>.<i>.role
     grupos   →  <base>.<gi>.area  e  <base>.<gi>.members.<i>.role     */
const areaKey = (gi) => (i18nBase && gi != null ? `${i18nBase}.${gi}.area` : undefined);
const roleKey = (gi, i) => {
  if (!i18nBase) return undefined;
  return gi != null ? `${i18nBase}.${gi}.members.${i}.role` : `${i18nBase}.${i}.role`;
};
---
<div class={cls}>
  {blocos.map(({ area, members: pessoas, gi }) => (
    <div class={area ? 'roster__group roster__group--titled' : 'roster__group'}>
      {area && <h3 class="roster__area" data-i18n={areaKey(gi)}>{area}</h3>}
      <ul class="roster__list">
        {pessoas.map((m, i) => (
          <li class="roster__row">
            <span class="roster__name">{m.name}</span>
            <span class="roster__role" data-i18n={roleKey(gi, i)}>{m.role}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
