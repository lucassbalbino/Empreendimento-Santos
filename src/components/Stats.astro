---
const { items, class: className, i18nBase } = Astro.props;
---
<div class:list={['stats', className]}>
  {items.map((s, i) => (
    <div class="stat">
      {s.target != null && s.target !== ''
        ? <div class="stat__num" data-target={s.target} data-prefix={s.prefix} data-suffix={s.suffix}>0</div>
        : <div class="stat__num stat__num--word">{s.value}</div>}
      <div class="stat__label" data-i18n={i18nBase && `${i18nBase}.${i}.label`}>{s.label}</div>
    </div>
  ))}
</div>
