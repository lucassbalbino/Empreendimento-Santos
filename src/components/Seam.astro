---
// Costura horizontal entre duas secções, sempre reta (sem cunha diagonal).
// Linha fina e, por baixo, uma legenda a três colunas — rótulo da secção
// seguinte | marca | ano — no idioma editorial do estudiobase2.com.
//   variant="light" → sobre .section branca
//   variant="alt"   → sobre .section--alt (cinza-claro)
//   variant="dark"  → sobre .section--dark
//   loose           → mais respiro no topo; usar quando a .seam fecha um
//                      bloco de imagem (foto, slider, painéis, carrossel)
//   bare            → sem o .container próprio; usar quando a .seam já vive
//                      dentro de outra .container (ex.: como eyebrow do
//                      título, na mesma div — evita duplicar o gutter)
const { label, variant = 'light', loose = false, i18n, class: extraClass = '', bare = false } = Astro.props;
const year = new Date().getFullYear();
---
<div class={`seam seam--${variant}${loose ? ' seam--loose' : ''}${extraClass ? ' ' + extraClass : ''}`}>
  {bare ? (
    <>
      <div class="seam__rule"></div>
      <div class="seam__meta">
        <span class="seam__label" data-i18n={i18n}>{label}</span>
        <span class="seam__brand">
          <img class="seam__logo seam__logo--ink" src="/images/logo-ams-santos-h-dark.png" alt="" />
          <img class="seam__logo seam__logo--paper" src="/images/logo-ams-santos-h-light.png" alt="" />
        </span>
        <span class="seam__index"><span class="seam__copy">&copy;</span>{year}</span>
      </div>
    </>
  ) : (
    <div class="container">
      <div class="seam__rule"></div>
      <div class="seam__meta">
        <span class="seam__label" data-i18n={i18n}>{label}</span>
        <span class="seam__brand">
          <img class="seam__logo seam__logo--ink" src="/images/logo-ams-santos-h-dark.png" alt="" />
          <img class="seam__logo seam__logo--paper" src="/images/logo-ams-santos-h-light.png" alt="" />
        </span>
        <span class="seam__index"><span class="seam__copy">&copy;</span>{year}</span>
      </div>
    </div>
  )}
</div>
