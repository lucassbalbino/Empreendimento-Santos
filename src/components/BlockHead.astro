---
const { eyebrow, title, lead, botao, href = "#" } = Astro.props;
---
<div class="block-head">
  <div class="block-head__text">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="display display--sm">{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {botao && <a class="btn" href={href}>{botao}</a>}
</div>
