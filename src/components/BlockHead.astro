---
const { eyebrow, title, lead, botao, href = "#", as = "h2" } = Astro.props;
const Title = as;
---
<div class="block-head">
  <div class="block-head__text">
    <span class="eyebrow">{eyebrow}</span>
    <Title class="display display--sm">{title}</Title>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {botao && <a class="btn" href={href}>{botao}</a>}
</div>
