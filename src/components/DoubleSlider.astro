---
// Double slider (layout de referencias/sites/LINKS.md → custom-double-slider).
// Slide de fundo full-bleed sincronizado com uma fila de miniaturas dos PRÓXIMOS
// empreendimentos, sangrada pela borda direita. Sem autoplay: navegação manual
// por setas, miniaturas, teclado (←/→) e swipe.
const { projetos, titulo, botao, href = '/portfolio' } = Astro.props;

// A fila de miniaturas é renderizada duas vezes para o deslize dar a volta sem
// salto visível — o script trata do "snap" quando chega ao fim da 1.ª cópia.
const thumbs = [...projetos, ...projetos];

// O corpo do título encolhe com o nº de caracteres para que nenhum nome passe
// de duas linhas dentro dos 40vw onde vive (ver .dslider__name) — a partir
// daí a leitura sofre mais do que ganha em impacto.
function nameSize(nome) {
  const n = nome.length;
  if (n > 30) return 'clamp(1.5rem, 3.2vw, 2.9rem)';
  if (n > 20) return 'clamp(1.9rem, 3.9vw, 3.4rem)';
  return 'clamp(2.2rem, 5.4vw, 5rem)';
}
---
<div class="dslider" data-dslider aria-roledescription="carousel" aria-label={titulo} data-i18n="home.portfolio.title" data-i18n-attr="aria-label">
  <div class="dslider__stage">
    {projetos.map((p, i) => (
      <article class="dslider__slide" data-slide data-slug={p.slug} aria-hidden={i !== 0 ? 'true' : undefined}>
        {p.imagem
          ? <img class="dslider__img" src={p.imagem} alt={p.nome} loading={i === 0 ? 'eager' : 'lazy'} />
          : <div class="dslider__img dslider__img--ph"></div>}
        <!-- Botão "Ver portfólio" + nome, empilhados no canto inferior
             esquerdo (o botão em cima). O bloco está ancorado por `bottom`
             fixo, não por `top`: quando o nome quebra em duas linhas, é o
             próprio fluxo normal que o empurra para cima, afastando-o do
             botão sem precisar de calcular a altura de nada. Vive dentro do
             slide, por isso desvanece com ele.
             O próprio nome é o link para o empreendimento: esta é a única
             passagem da home para a página de detalhe, e sem ela o slide não
             levava a lado nenhum. Sem sublinhado — o link tem de se ler como
             o nome, não como um botão à parte. -->
        <div class="dslider__info">
          <a class="btn dslider__all" href={href} data-i18n="home.portfolio.botao">{botao}</a>
          <h3 class="dslider__name" style={`--name-size:${nameSize(p.nome)}`}>
            <a href={`/empreendimentos/${p.slug}`}>{p.nome}</a>
          </h3>
        </div>
      </article>
    ))}
  </div>

  <!-- Véu único sobre o palco, e não por slide: se vivesse dentro do slide
       desapareceria durante o crossfade e o texto ficava um instante nu.
       Fica ABAIXO das miniaturas (z-index 1 contra 3), por isso nunca as
       cobre. Serve o rótulo no topo e o nome à esquerda; a base é leve. -->
  <div class="dslider__scrim" aria-hidden="true"></div>

  <!-- Rótulo da section: a home tem título em todas as outras secções e esta
       não tinha nenhum. Fica no topo-esquerdo, abaixo do header fixo, em corpo
       pequeno — dá âncora sem disputar com o nome do empreendimento. -->
  <p class="dslider__label" data-i18n="home.portfolio.title">{titulo}</p>

  <div class="dslider__foot">
    <div class="dslider__arrows">
      <button class="dslider__arrow" type="button" data-prev aria-label="Empreendimento anterior" data-i18n="common.slider.prev" data-i18n-attr="aria-label">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m0 0 6-6m-6 6 6 6"/></svg>
      </button>
      <button class="dslider__arrow" type="button" data-next aria-label="Empreendimento seguinte" data-i18n="common.slider.next" data-i18n-attr="aria-label">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m0 0-6-6m6 6-6 6"/></svg>
      </button>
    </div>
    <div class="dslider__thumbs">
      <div class="dslider__track" data-track>
        {thumbs.map((p, i) => (
          <button
            class="dslider__thumb"
            type="button"
            data-thumb
            data-target={i % projetos.length}
            tabindex={i < projetos.length ? undefined : '-1'}
            aria-hidden={i < projetos.length ? undefined : 'true'}
          >
            {p.imagem
              ? <img src={p.imagem} alt="" loading="lazy" />
              : <span class="dslider__thumb-ph"></span>}
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import SplitType from 'split-type';

  const SWIPE_MIN = 40; // px — abaixo disto é toque, não swipe
  // Depois de o crossfade da imagem (.dslider__slide, .8s) terminar: só aí o
  // nome de saída é reposto ao estado escondido, para o snap instantâneo
  // (sem transição) nunca ser visto — a esta altura o slide já está a 0 de
  // opacidade de qualquer forma.
  const NAME_HIDE_DELAY = 850;

  // Com <ViewTransitions /> os scripts de módulo só correm UMA vez. Por isso o
  // setup religa-se a astro:page-load (1.ª carga + cada nav suave) — senão a
  // home aberta por navegação suave nunca pintava o slide activo e a imagem
  // ficava invisível (só aparecia no refresh). A guarda por dataset impede
  // religar o mesmo DOM duas vezes.
  function setup() {
   document.querySelectorAll('[data-dslider]').forEach((root) => {
    if (root.dataset.dsliderBound) return;
    root.dataset.dsliderBound = '1';
    const slides = [...root.querySelectorAll('[data-slide]')];
    const track = root.querySelector('[data-track]');
    const thumbs = [...root.querySelectorAll('[data-thumb]')];
    const count = root.querySelector('[data-count]');
    const total = slides.length;
    if (total < 2) return;

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let pos = 1; // posição da fila, em nº de miniaturas (a fila começa no slide seguinte)

    // O nome de cada slide anima como os títulos de secção: split por linha,
    // cada linha sobe de baixo de uma máscara. Reutiliza as MESMAS classes/CSS
    // de src/scripts/split-reveal.js (.line/.line__inner/.split-ready/
    // .is-revealed) — só que aqui repete a cada troca de slide, e não uma vez
    // só ao entrar em vista. Alvo é a <a> (texto puro), não o <h3> que a
    // envolve — split-type parte o elemento que recebe, e um <h3> com um link
    // lá dentro não é o mesmo "texto plano" que o resto do site sempre lhe dá.
    const names = slides.map((s) => s.querySelector('.dslider__name a'));
    function splitOne(el) {
      const split = new SplitType(el, { types: 'lines' });
      split.lines.forEach((line, i) => {
        const inner = document.createElement('span');
        inner.className = 'line__inner';
        inner.style.setProperty('--i', i);
        while (line.firstChild) inner.appendChild(line.firstChild);
        line.appendChild(inner);
      });
      el.classList.add('split-ready');
    }
    if (!calm.matches) {
      names.forEach((el) => { if (el) splitOne(el); });
    }

    // Troca de idioma: o nome de cada empreendimento vem do dicionário i18n
    // (chave pelo slug em data-slug). O SplitType já embrulhou o texto PT em
    // spans .line__inner — só trocar o textContent destruía essa marcação,
    // por isso refaz-se o split depois de mudar o texto, preservando
    // .is-revealed se o slide já estava visível.
    function applyNameTranslations() {
      if (!window.__amsI18n) return;
      slides.forEach((s, i) => {
        const slug = s.dataset.slug;
        const a = names[i];
        if (!a || !slug) return;
        if (!a.dataset.ptName) a.dataset.ptName = a.textContent;
        const text = window.__amsI18n.get('empreendimentos.' + slug + '.nome', a.dataset.ptName);
        if (text === (a.dataset.currentName || a.dataset.ptName)) return;
        a.dataset.currentName = text;
        const wasRevealed = a.classList.contains('is-revealed');
        // SplitType guarda o HTML original numa cache interna e o RESTAURA
        // sempre que o elemento é dividido de novo — por isso split.revert()
        // corre primeiro (limpa essa cache), só DEPOIS é que o texto novo
        // entra, e só então se volta a dividir; caso contrário o revert()
        // implícito do próximo split apagava a tradução e repunha o PT.
        SplitType.revert(a);
        a.textContent = text;
        a.classList.remove('split-ready');
        if (!calm.matches) splitOne(a);
        if (wasRevealed) a.classList.add('is-revealed');
      });
    }
    applyNameTranslations();
    if (window.__amsI18n) window.__amsI18n.onChange(applyNameTranslations);

    function revealName(i) {
      names[i]?.classList.add('is-revealed');
    }
    // Snap instantâneo ao estado escondido (sem transição): usado só depois
    // do crossfade da imagem já ter terminado, nunca a meio dele.
    function hideName(i) {
      const el = names[i];
      if (!el) return;
      el.classList.add('split-instant');
      el.classList.remove('is-revealed');
      void el.offsetHeight; // força o reflow antes de reativar a transição
      el.classList.remove('split-instant');
    }

    // Passo do deslize = largura real de uma miniatura + gap (ambos fluidos).
    function step() {
      if (!thumbs[0] || !thumbs[1]) return 0;
      return thumbs[1].getBoundingClientRect().left - thumbs[0].getBoundingClientRect().left;
    }

    function setPos(p, animate) {
      pos = p;
      const smooth = animate && !calm.matches;
      track.classList.toggle('is-instant', !smooth);
      track.style.transform = `translate3d(${-pos * step()}px,0,0)`;
      if (!smooth) void track.offsetWidth; // força o reflow antes de voltar a animar
    }

    function paint() {
      slides.forEach((s, i) => {
        s.classList.toggle('is-active', i === index);
        if (i === index) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      thumbs.forEach((t) => t.classList.toggle('is-current', Number(t.dataset.target) === index));
      if (count) count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
    }

    function go(next) {
      const prev = index;
      const wrapFwd = index === total - 1 && next === 0;
      const wrapBack = index === 0 && next === total - 1;
      index = next;
      paint();
      revealName(index);
      // Só esconde o nome de saída depois de ele já estar invisível (ver
      // NAME_HIDE_DELAY). Confere `prev !== index` no momento em que o timeout
      // dispara: numa ida-e-volta rápida (A → B → A antes dos 850ms), o slide A
      // já voltou a ser o activo e já foi revelado de novo — sem esta guarda,
      // este hide tardio apagava-o outra vez por cima da revelação nova.
      setTimeout(() => { if (prev !== index) hideName(prev); }, NAME_HIDE_DELAY);
      // Nas voltas, salta primeiro para a posição equivalente na outra cópia da
      // fila (visualmente idêntica) e só depois anima — senão a fila percorreria
      // a lista inteira ao contrário à vista do utilizador. O salto é aplicado
      // com um reflow forçado dentro de setPos(), e não com requestAnimationFrame:
      // o rAF fica suspenso em abas em segundo plano e a fila ficaria desalinhada.
      if (wrapFwd || wrapBack) {
        setPos(wrapFwd ? 0 : total + 1, false);
        setPos(wrapFwd ? 1 : total, true);
      } else {
        setPos(index + 1, true);
      }
    }

    const nextOf = (d) => (index + d + total) % total;

    root.querySelector('[data-prev]').addEventListener('click', () => go(nextOf(-1)));
    root.querySelector('[data-next]').addEventListener('click', () => go(nextOf(1)));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.target))));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(nextOf(-1)); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(nextOf(1)); }
    });

    // Swipe horizontal (só quando o gesto é claramente horizontal).
    let startX = null;
    let startY = 0;
    const stage = root.querySelector('.dslider__stage');
    stage.addEventListener('pointerdown', (e) => { startX = e.clientX; startY = e.clientY; });
    stage.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      startX = null;
      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) < Math.abs(dy)) return;
      go(nextOf(dx < 0 ? 1 : -1));
    });

    // O passo depende da largura da miniatura, que é fluida.
    window.addEventListener('resize', () => setPos(pos, false), { passive: true });
    paint();
    setPos(1, false);

    // 1.ª revelação do nome (slide inicial): só quando a secção entra bem no
    // ecrã, com o mesmo gatilho tardio do resto do site (ver REVEAL_MARGIN em
    // split-reveal.js) — não assim que a página carrega, que a secção pode
    // estar bem abaixo da dobra. As trocas seguintes (go()) já não passam por
    // aqui: nessa altura o utilizador está a olhar mesmo para o slider.
    if (!calm.matches) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { revealName(index); io.unobserve(e.target); }
          });
        }, { threshold: 0, rootMargin: '0px 0px -25% 0px' });
        io.observe(root);
      } else {
        revealName(index);
      }
    }
   });
  }

  document.addEventListener('astro:page-load', setup);
  // Também já: se o astro:page-load desta navegação já disparou antes deste
  // script correr, o listener acima não o apanharia.
  setup();
</script>
