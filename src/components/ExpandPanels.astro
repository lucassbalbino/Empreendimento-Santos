---
import { slugify } from '../utils/slug.js';
const { cards } = Astro.props;
---
<div class="panels">
  {cards.map((c, i) => (
    <a class={i === 0 ? "panel is-active" : "panel"} href={c.href ?? `/empreendimentos/${slugify(c.title)}`}>
      <img class="panel__bg" src="/images/hero-image.webp" alt="" loading="lazy" />
      <span class="panel__label">{c.title}</span>
      <div class="panel__content">
        <h3 class="panel__title">{c.title}</h3>
        <div class="panel__meta">{c.meta}</div>
      </div>
    </a>
  ))}
</div>
