---
const { projetos } = Astro.props;
---
<div class="panels">
  {projetos.map((p, i) => (
    <a class={i === 0 ? "panel is-active" : "panel"} href={`/empreendimentos/${p.slug}`}>
      <img class="panel__bg" src={p.imagem ?? '/images/hero-image.webp'} alt="" loading="lazy" />
      <span class="panel__label">{p.nome}</span>
      <div class="panel__content">
        <h3 class="panel__title">{p.nome}</h3>
        <div class="panel__meta">{p.localizacao} · {p.entrega}</div>
      </div>
    </a>
  ))}
</div>
