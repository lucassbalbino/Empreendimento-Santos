---
// Card de empreendimento. Usa proj.slug (e não slugify do nome) para o link,
// por isso a listagem e a página de detalhe não podem divergir.
const { proj, dark = false } = Astro.props;
---
<a class="card" href={`/empreendimentos/${proj.slug}`}>
  <div class="card__media">
    {proj.imagem
      ? <img class="card__img" src={proj.imagem} alt={proj.nome} loading="lazy" />
      : <div class={dark ? 'ph ph--dark' : 'ph'}></div>}
    {proj.imagem && !proj.imagemReal && <span class="img-prov">Imagem provisória</span>}
    <div class="card__overlay">
      <h3 class="card__title">{proj.nome}</h3>
      <div class="card__meta">{proj.localizacao} · {proj.tipologia}</div>
      <span class="card__cta">Ver empreendimento</span>
    </div>
  </div>
</a>
