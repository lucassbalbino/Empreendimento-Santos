---
// Card de empreendimento. Por defeito liga à página de detalhe (proj.slug), por
// isso a listagem e a página de detalhe não podem divergir. Com modal={true} não
// navega: é um botão que abre a janela de detalhe na própria página (histórico).
const { proj, dark = false, modal = false } = Astro.props;
const Tag = modal ? 'button' : 'a';
const attrs = modal
  ? { type: 'button', class: 'card card--modal', 'data-slug': proj.slug }
  : { class: 'card', href: `/empreendimentos/${proj.slug}` };
---
<Tag {...attrs}>
  <div class="card__media">
    {proj.imagem
      ? <img class="card__img" src={proj.imagem} alt={proj.nome} loading="lazy" />
      : <div class={dark ? 'ph ph--dark' : 'ph'}></div>}
    <div class="card__overlay">
      <h3 class="card__title" data-i18n={`empreendimentos.${proj.slug}.nome`}>{proj.nome}</h3>
      <div class="card__meta">{proj.localizacao} · <span data-i18n={`empreendimentos.${proj.slug}.tipologia`}>{proj.tipologia}</span></div>
    </div>
  </div>
</Tag>
