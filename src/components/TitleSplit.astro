---
// Título de secção, sempre na mesma tipografia (Kompot Display).
// O texto é uma só caixa: as quebras de linha são naturais, dadas pela medida
// de cada variante (max-width em ch) e equilibradas pelo browser
// (text-wrap:balance). Não há contagem de palavras a impor onde partir — era
// isso que engessava os títulos, obrigando cada um a caber numa forma fixa
// independentemente do idioma ou do comprimento do texto.
// O <span> interior existe para o split-reveal: é ele que o split-type parte
// em .line (ver src/scripts/split-reveal.js) e que o motor de i18n reescreve
// (ver applyTitleSplit em public/main.js).
interface Props {
  text: string;
  tag?: 'h1' | 'h2';
  class?: string;
  [attr: string]: any;
}
const { text, tag = 'h2', class: extraClass = '', ...rest } = Astro.props;
const Tag = tag;
const classes = ['title-split', extraClass].filter(Boolean).join(' ');
---
<Tag class={classes} {...rest}>
  <span class="title-split__text">{text}</span>
</Tag>
