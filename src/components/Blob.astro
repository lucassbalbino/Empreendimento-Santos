---
/* Textura de fundo gigante, cinzenta-quase-invisível, a sangrar por dois
   cantos opostos do bloco que a hospeda. Ver a nota em styles.css
   (Blob de fundo). */
---
<div class="blob-layer" aria-hidden="true">
  <span class="blob blob--tr-a"></span>
  <span class="blob blob--tr-b"></span>
  <span class="blob blob--bl-a"></span>
  <span class="blob blob--bl-b"></span>
</div>
