---
// Overlay que desce a cobrir o ecrã na troca de página. `transition:persist`
// mantém o MESMO elemento vivo através da troca de DOM, para a animação
// continuar por cima do swap. A lógica entra na Task 6.
---
<div id="page-curtain" class="curtain" aria-hidden="true" transition:persist="page-curtain">
  <div class="curtain__img"></div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Movimento lento e bem visível: a imagem da hero desce devagar e
  // materializa-se (fade) enquanto desce, a assentar no fim — não cai de golpe.
  // Easing com desaceleração (easeOut) para suavizar a chegada.
  const DOWN = 1200, HOLD = 150;
  const EASE = 'cubic-bezier(.8,0,.2,1)'; // "wipeFront" — valor exato da referência

  const curtain = document.getElementById('page-curtain');
  const imgLayer = curtain.querySelector('.curtain__img');
  let busy = false;

  // Lê a URL da hero image do documento de destino (inline background-image).
  function heroUrlFromDoc(doc) {
    const bg = doc.querySelector('.hero__bg--img');
    if (!bg) return null;
    const s = bg.getAttribute('style') || '';
    const m = s.match(/url\((['"]?)(.*?)\1\)/);
    return m ? m[2] : null;
  }

  async function fetchDoc(href) {
    const res = await fetch(href, { headers: { Accept: 'text/html' } });
    const html = await res.text();
    return new DOMParser().parseFromString(html, 'text/html');
  }

  // Não bloquear para sempre se a imagem falhar/demorar. `decode()` garante que o
  // bitmap fica pronto a pintar no 1.º frame: sem isto, o elemento novo da hero
  // pode entrar por decodificar no instante em que a cortina se levanta e vê-se o
  // branco do body por baixo por 1–2 frames (o flash que quebra o smooth).
  // Failsafe por timeout para nunca prender a transição se o decode falhar/demorar.
  function preloadImg(url) {
    return new Promise((resolve) => {
      if (!url) return resolve();
      const im = new Image();
      im.src = url;
      if (im.decode) im.decode().then(resolve, resolve);
      else im.onload = im.onerror = () => resolve();
      setTimeout(resolve, 1500);
    });
  }

  // Estados de clip-path do wipe (inset top right bottom left):
  //  ambos partem invisíveis (recolhidos numa aresta) e crescem até COVERED.
  //  UP:   recolhida no fundo (top 100%) → sobe de baixo para cima.
  //  DOWN: recolhida no topo (bottom 100%) → desce de cima para baixo.
  //  A origem decide a direção: navbar (header) desce; o resto sobe.
  const COVER_FROM_UP   = 'inset(100% 0 0 0)';
  const COVER_FROM_DOWN = 'inset(0 0 100% 0)';
  const COVERED         = 'inset(0 0 0 0)';

  function clipWipe(from, to, d) {
    return curtain.animate(
      [{ clipPath: from }, { clipPath: to }],
      { duration: d, easing: EASE, fill: 'forwards' }
    ).finished;
  }

  // Texto da hero entra depois de assentar — só na navegação por cortina, para
  // não afetar a 1.ª carga (onde a hero aparece normalmente).
  function revealHeroText() {
    const inner = document.querySelector('.hero .hero__inner');
    if (!inner) return;
    inner.animate(
      [{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'translateY(0)' }],
      { duration: 400, easing: 'cubic-bezier(.2,.6,.2,1)', fill: 'backwards' }
    );
  }

  async function run(href, dir) {
    if (busy) return;
    busy = true;
    window.__amsCurtainBusy = true;
    try {
      let doc = null;
      try { doc = await fetchDoc(href); } catch (_) {}
      const url = doc ? heroUrlFromDoc(doc) : null;
      await preloadImg(url);

      imgLayer.style.backgroundImage = url ? `url("${url}")` : '';
      curtain.classList.toggle('curtain--solid', !url);
      curtain.classList.add('curtain--active');

      // Desce a cobrir; a imagem materializa-se (fade 0→1) enquanto desce,
      // para a hero da página nova entrar bem visível, não só a deslizar.
      imgLayer.animate(
        [{ opacity: 0 }, { opacity: 1 }],
        { duration: DOWN, easing: EASE }
      );
      // Cobre: wipe até tapar. Sentido conforme a origem do click (navbar desce).
      const coverFrom = dir === 'down' ? COVER_FROM_DOWN : COVER_FROM_UP;
      window.__amsLenis?.stop();
      await clipWipe(coverFrom, COVERED, DOWN);
      await new Promise((r) => setTimeout(r, HOLD));

      // Troca a página POR BAIXO da cortina (coberta) e espera montar.
      // Failsafe: se `astro:page-load` não disparar (falha de navegação), não
      // deixar a cortina presa — rejeita ao fim de 5s e cai no catch.
      let timer;
      const swapped = new Promise((resolve, reject) => {
        const h = () => { clearTimeout(timer); document.removeEventListener('astro:page-load', h); resolve(); };
        document.addEventListener('astro:page-load', h);
        timer = setTimeout(() => {
          document.removeEventListener('astro:page-load', h);
          reject(new Error('astro:page-load timeout'));
        }, 5000);
      });
      navigate(href);
      await swapped;

      // Espera a hero nova COMPOR mesmo antes de levantar a cortina. Na home a
      // hero tem `will-change:transform` (body.is-home): é promovida a uma camada
      // GPU própria, cuja 1.ª rasterização chega um frame depois do swap. Sem esta
      // espera a cortina retirava-se sobre a camada ainda vazia e via-se o branco
      // do body por um frame (o flash). Dois rAF = a camada já compôs. A cortina
      // continua a tapar durante estes ~2 frames.
      await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

      // Transição de um só tempo: a página nova (hero full-screen, MESMA imagem
      // e MESMA gradação) já está por baixo da cortina. Não há segundo wipe — a
      // cortina é retirada (a imagem coincide, sem costura) e os elementos da
      // hero entram a acompanhar: a imagem "vem com os elementos".
      revealHeroText();
      // Depois do swap já existe uma instância NOVA do Lenis (recriada no
      // astro:page-load); retomamos essa.
      window.__amsLenis?.start();
    } catch (err) {
      // Navegação falhou/expirou: garante que o utilizador chega ao destino
      // com uma navegação normal, em vez de ficar preso sob a cortina.
      window.location.href = href;
      return;
    } finally {
      curtain.classList.remove('curtain--active', 'curtain--solid');
      // Cancela o fill:forwards do cover (e o fade da imagem): a cortina volta ao
      // repouso do CSS — clip-path inset(100%…) = invisível. Sem isto, a próxima
      // transição começaria com a cortina a tapar tudo por um frame (flash).
      curtain.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      imgLayer.style.backgroundImage = '';
      busy = false;
      window.__amsCurtainBusy = false;
    }
  }

  // "Menu + botões principais": links do header OU .btn, internos, mesma origem.
  function qualifies(a) {
    if (!a || a.target === '_blank' || a.hasAttribute('data-no-curtain')) return false;
    if (a.origin !== location.origin) return false;
    if (new URL(a.href).pathname === location.pathname) return false; // mesma página / âncora
    return !!a.closest('.site-header') || a.classList.contains('btn');
  }

  // CAPTURA: o router do Astro (ViewTransitions) escuta o click em bubble e faz
  // preventDefault primeiro; se a cortina escutasse em bubble, veria
  // defaultPrevented=true e desistia (a cortina nunca corria — só o crossfade do
  // Astro, "quase instantâneo"). Em captura corremos ANTES do Astro: fazemos
  // preventDefault e é o Astro que depois vê defaultPrevented e desiste; a
  // navegação passa a ser conduzida por nós (run → navigate).
  document.addEventListener('click', (e) => {
    if (reduce || e.defaultPrevented || e.button !== 0 ||
        e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = e.target.closest && e.target.closest('a[href]');
    if (!a || !qualifies(a)) return;
    e.preventDefault();
    // Navbar (qualquer link do header) → cortina desce do topo; resto → sobe.
    run(a.href, a.closest('.site-header') ? 'down' : 'up');
  }, { capture: true });
</script>
