---
import site from '../data/site.json';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/sobre-nos', label: 'Sobre Nós' },
  { href: '/portfolio', label: 'Portfólio' },
  { href: '/historico', label: 'Histórico' },
  { href: 'https://www.sfproperties.pt/', label: 'SF Properties', external: true },
  { href: '/equipa', label: 'Equipa' },
  { href: '/contactos', label: 'Contactos' },
];
---
<header class="site-header">
  <div class="container">
    <a class="logo" href="/" aria-label="AM Santos — Empreendimentos">
      <img class="logo__img logo__img--light" src="/images/logo-ams-santos-light.png" alt="AM Santos — Empreendimentos" />
      <img class="logo__img logo__img--dark" src="/images/logo-ams-santos.png" alt="AM Santos — Empreendimentos" />
    </a>
    <nav class="nav">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            {l.external
              ? <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
              : <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>}
          </li>
        ))}
      </ul>
      <span class="nav__lang">EN</span>
      <span class="nav__search">⌕</span>
    </nav>
    <button class="nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</header>
