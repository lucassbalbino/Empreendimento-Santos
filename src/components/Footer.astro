---
import site from '../data/site.json';
const moradaLinhas = site.footer.morada.split('\n');
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <span class="logo footer-logo"><img src="/images/logo-ams-santos-h-light.png" alt="AM Santos — Empreendimentos" /></span>
        <p data-i18n="site.footer.blurb">{site.footer.blurb}</p>
        <div class="socials">
          <a href="#" aria-label="Instagram" data-i18n="common.footer.instagram" data-i18n-attr="aria-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17" cy="7" r=".6" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="#" aria-label="Facebook" data-i18n="common.footer.facebook" data-i18n-attr="aria-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="#" aria-label="LinkedIn" data-i18n="common.footer.linkedin" data-i18n-attr="aria-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-12h4v1.6a5 5 0 0 1 2-1.6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h4 data-i18n="common.footer.moradaLabel">Morada</h4>
        <p data-i18n="site.footer.morada" data-i18n-multiline>{moradaLinhas.map((linha, i) => (<>{i > 0 && <br />}{linha}</>))}</p>
      </div>
      <div class="footer-col">
        <h4 data-i18n="common.footer.contactosLabel">Contactos</h4>
        <p><a href={`mailto:${site.footer.email}`}>{site.footer.email}</a><br><a href="#">{site.footer.telefone}</a></p>
      </div>
      <div class="footer-col">
        <h4 data-i18n="common.footer.newsletterLabel">Newsletter</h4>
        <div class="news"><input type="email" placeholder="o.seu.email@exemplo.pt" data-i18n="common.footer.newsletterPlaceholder" data-i18n-attr="placeholder"><button>→</button></div>
        <label class="check check--footer"><input type="checkbox"> <span data-i18n="common.footer.newsletterConsent">Aceito receber novidades e comunicações da AM Santos.</span></label>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{site.footer.copyright}</span>
      <span data-i18n="site.footer.assinatura">{site.footer.assinatura}</span>
    </div>
  </div>
</footer>
