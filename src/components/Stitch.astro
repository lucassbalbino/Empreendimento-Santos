---
// Costura diagonal entre duas secções de cor diferente: uma cunha da cor da
// secção ANTERIOR (variant) desce sobre o topo da seguinte, cortando a
// fronteira na diagonal (ver .stitch no styles.css). Vive FORA de <section>.
//   variant="light"  → cunha branca  (.section acima)
//   variant="alt"    → cunha cinza   (.section--alt acima)
//   variant="dark"   → cunha escura  (.section--dark acima)
const { variant = 'light' } = Astro.props;
---
<div class={`stitch stitch--${variant}`}>
  <svg class="stitch__cut" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
    <polygon class="stitch__wedge" points="0,0 1000,0 0,60"></polygon>
  </svg>
</div>
