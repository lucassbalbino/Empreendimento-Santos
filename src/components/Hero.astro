---
import TitleSplit from './TitleSplit.astro';
const { title, minHeight, image, titleI18n } = Astro.props;
---
<section class="hero" style={minHeight ? `min-height:${minHeight}` : undefined}>
  <div
    class={image ? 'hero__bg hero__bg--img' : 'hero__bg'}
    style={image ? `background-image:url(${image})` : undefined}
  ></div>
  <div class="hero__overlay"></div>
  <div class="hero__inner">
    <div class="container">
      <TitleSplit text={title} tag="h1" class="title-split--hero" data-i18n={titleI18n} data-i18n-split="1" />
    </div>
  </div>
  <div class="hero__scroll"><span data-i18n="common.hero.scroll">Scroll</span><span class="line"></span></div>
</section>
